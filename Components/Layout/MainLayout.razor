@inherits LayoutComponentBase
@inject NavigationManager Nav
@inject AuthState AuthState
@implements IDisposable

<div class="app-shell">
    <div class="app-frame">
        <div class="rail-backdrop @(_railAbierto ? "open" : "")" @onclick="CerrarRail"></div>
        <nav class="app-rail @(_railAbierto ? "open" : "")">
            <div class="app-rail-mark">
                <div class="mark-box"><img src="/img/nestle-logo.png" alt="Nestlé" /></div>
                <span class="mark-text">Inventario</span>
            </div>

            @if (AuthState.HasPermission(Permisos.InicioVer))
            {
                <RailLink Href="/inicio" IconName="home" Label="Inicio" CurrentPath="@_path" />
            }

            @if (AuthState.HasPermission(Permisos.ProductosVer))
            {
                <RailLink Href="/productos" IconName="box" Label="Productos" CurrentPath="@_path" />
            }
            @if (AuthState.HasPermission(Permisos.MovimientosVer))
            {
                <RailLink Href="/movimientos" IconName="shuffle" Label="Movimientos" CurrentPath="@_path" />
            }
            @if (AuthState.HasPermission(Permisos.SolicitudesVer))
            {
                <RailLink Href="/solicitudes" IconName="clipboard" Label="Solicitudes" CurrentPath="@_path" />
            }
            else if (AuthState.HasPermission(Permisos.SolicitudesCrear))
            {
                <RailLink Href="/solicitudes/mias" IconName="clipboard" Label="Mis solicitudes" CurrentPath="@_path" />
            }
            @if (AuthState.HasPermission(Permisos.ConteosVer))
            {
                <RailLink Href="/conteos" IconName="check-list" Label="Conteo físico" CurrentPath="@_path" />
            }

            @if (AuthState.HasPermission(Permisos.CategoriasVer) || AuthState.HasPermission(Permisos.AreasVer) || AuthState.HasPermission(Permisos.UbicacionesVer) || AuthState.HasPermission(Permisos.UnidadesVer) || AuthState.HasPermission(Permisos.AlmacenesVer))
            {
                <div class="rail-section">Catálogos</div>
            }
            @if (AuthState.HasPermission(Permisos.CategoriasVer))
            {
                <RailLink Href="/categorias" IconName="tag" Label="Categorías" CurrentPath="@_path" />
            }
            @if (AuthState.HasPermission(Permisos.AreasVer))
            {
                <RailLink Href="/areas" IconName="building" Label="Áreas" CurrentPath="@_path" />
            }
            @if (AuthState.HasPermission(Permisos.AlmacenesVer))
            {
                <RailLink Href="/almacenes" IconName="warehouse" Label="Almacenes" CurrentPath="@_path" />
            }
            @if (AuthState.HasPermission(Permisos.UbicacionesVer))
            {
                <RailLink Href="/ubicaciones" IconName="rack" Label="Ubicaciones" CurrentPath="@_path" />
            }
            @if (AuthState.HasPermission(Permisos.UnidadesVer))
            {
                <RailLink Href="/unidades" IconName="ruler" Label="Unidades" CurrentPath="@_path" />
            }

            @if (AuthState.HasPermission(Permisos.UsuariosGestionar) || AuthState.HasPermission(Permisos.RolesGestionar) || AuthState.HasPermission(Permisos.PaisesVer))
            {
                <div class="rail-section">Administración</div>
            }
            @if (AuthState.HasPermission(Permisos.UsuariosGestionar))
            {
                <RailLink Href="/usuarios" IconName="users" Label="Usuarios" CurrentPath="@_path" />
            }
            @if (AuthState.HasPermission(Permisos.RolesGestionar))
            {
                <RailLink Href="/roles" IconName="shield" Label="Roles" CurrentPath="@_path" />
            }
            @if (AuthState.HasPermission(Permisos.PaisesVer))
            {
                <RailLink Href="/paises" IconName="globe" Label="Países" CurrentPath="@_path" />
            }

            <div class="rail-footer">
                <div class="rail-user">
                    <span class="rail-user-name">@AuthState.NombreCompleto</span>
                    <span class="rail-user-role">@AuthState.RolNombre</span>
                </div>
                <button type="button" class="btn btn-ghost btn-sm" style="color:var(--sidebar-text);width:100%;justify-content:flex-start" @onclick="CerrarSesion">
                    <Icon Name="arrow-left" Size="14" />
                    Cerrar sesión
                </button>
            </div>
        </nav>

        <div class="app-body">
            <div class="app-topbar no-print">
                <button type="button" class="hamburger-btn" aria-label="Abrir menú" @onclick="() => _railAbierto = true">
                    <Icon Name="menu" Size="18" />
                </button>
                <span class="card-title" style="white-space:nowrap">@ScreenTitle()</span>
                <span class="tag tag-outline" style="margin-left:auto;flex-shrink:0;display:flex;align-items:center;gap:6px" title="País de la sesión">
                    <Bandera CodigoIso="@AuthState.PaisCodigoIso" Width="16" />
                    <span class="pais-nombre-texto">@AuthState.PaisNombre</span>
                </span>
                <span class="tag tag-outline rol-tag" style="flex-shrink:0">@AuthState.RolNombre</span>
            </div>

            <main class="app-main">
                @Body
            </main>
        </div>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Ocurrió un error inesperado.
    <a href="." class="reload">Recargar</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private string _path = "";

    // Cajón del rail en mobile (ver media query en app.css, breakpoint 900px) — en
    // desktop el CSS ignora esta clase, el rail siempre se ve como columna fija.
    private bool _railAbierto;

    protected override void OnInitialized()
    {
        if (!AuthState.IsAuthenticated)
        {
            Nav.NavigateTo("/", forceLoad: true);
            return;
        }

        _path = new Uri(Nav.Uri).AbsolutePath;
        Nav.LocationChanged += OnLocationChanged;
        AuthState.OnChange += StateHasChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        _path = new Uri(e.Location).AbsolutePath;
        _railAbierto = false; // navegar a una página nueva cierra el cajón en mobile
        InvokeAsync(StateHasChanged);
    }

    private void CerrarRail() => _railAbierto = false;

    private void CerrarSesion()
    {
        AuthState.SignOut();
        Nav.NavigateTo("/", forceLoad: true);
    }

    private string ScreenTitle() => _path switch
    {
        var p when p.StartsWith("/productos") => "Productos",
        var p when p.StartsWith("/movimientos") => "Movimientos",
        "/solicitudes/mias" => "Mis solicitudes",
        var p when p.StartsWith("/solicitudes") => "Solicitudes",
        var p when p.StartsWith("/conteos") => "Conteo físico",
        var p when p.StartsWith("/categorias") => "Categorías",
        var p when p.StartsWith("/almacenes") => "Almacenes",
        var p when p.StartsWith("/ubicaciones") => "Ubicaciones",
        var p when p.StartsWith("/unidades") => "Unidades",
        var p when p.StartsWith("/areas") => "Áreas",
        var p when p.StartsWith("/usuarios") => "Usuarios",
        var p when p.StartsWith("/roles") => "Roles",
        var p when p.StartsWith("/paises") => "Países",
        _ => "Inicio",
    };

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        AuthState.OnChange -= StateHasChanged;
    }
}
