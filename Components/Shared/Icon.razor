@* Íconos de línea (stroke=currentColor, viewBox 24x24) — mismo estilo que el mockup de referencia. *@

<svg width="@Size" height="@Size" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    @switch (Name)
    {
        case "home":
            <path d="m3 9 9-7 9 7" />
            <path d="M4 10v10a1 1 0 0 0 1 1h3a1 1 0 0 0 1-1v-4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v4a1 1 0 0 0 1 1h3a1 1 0 0 0 1-1V10" />
            break;
        case "box":
            <rect x="3" y="3" width="7" height="7" />
            <rect x="14" y="3" width="7" height="7" />
            <rect x="3" y="14" width="7" height="7" />
            <rect x="14" y="14" width="7" height="7" />
            break;
        case "shuffle":
            <path d="m17 2 4 4-4 4" />
            <path d="M3 11v-1a4 4 0 0 1 4-4h14" />
            <path d="m7 22-4-4 4-4" />
            <path d="M21 13v1a4 4 0 0 1-4 4H3" />
            break;
        case "ruler":
            <path d="M16.5 2.5a2.12 2.12 0 0 1 3 3L6 19l-4 1 1-4z" />
            <path d="M14 5.5 16.5 8" />
            <path d="M11 8.5 13.5 11" />
            <path d="M8 11.5 10.5 14" />
            break;
        case "tag":
            <path d="M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z" />
            <circle cx="7.5" cy="7.5" r="1" />
            break;
        case "rack":
            <rect x="3" y="4" width="18" height="4" />
            <path d="M5 8v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8" />
            <line x1="10" y1="13" x2="14" y2="13" />
            break;
        case "building":
            <rect x="4" y="2" width="16" height="20" rx="1" />
            <line x1="9" y1="7" x2="9" y2="7.01" />
            <line x1="15" y1="7" x2="15" y2="7.01" />
            <line x1="9" y1="11" x2="9" y2="11.01" />
            <line x1="15" y1="11" x2="15" y2="11.01" />
            <line x1="9" y1="15" x2="9" y2="15.01" />
            <line x1="15" y1="15" x2="15" y2="15.01" />
            break;
        case "clipboard":
            <rect x="8" y="2" width="8" height="4" rx="1" />
            <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2" />
            <path d="M9 13h6" />
            <path d="M9 17h6" />
            break;
        case "check-list":
            <path d="m3 7 2 2 4-4" />
            <path d="M13 6h8" />
            <path d="m3 15 2 2 4-4" />
            <path d="M13 16h8" />
            break;
        case "print":
            <polyline points="6 9 6 2 18 2 18 9" />
            <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2" />
            <rect x="6" y="14" width="12" height="8" />
            break;
        case "download":
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
            <polyline points="7 10 12 15 17 10" />
            <line x1="12" y1="15" x2="12" y2="3" />
            break;
        case "arrow-left":
            <line x1="19" y1="12" x2="5" y2="12" />
            <polyline points="12 19 5 12 12 5" />
            break;
        case "check":
            <polyline points="20 6 9 17 4 12" />
            break;
        case "x":
            <line x1="18" y1="6" x2="6" y2="18" />
            <line x1="6" y1="6" x2="18" y2="18" />
            break;
        case "undo":
            <path d="M3 7v6h6" />
            <path d="M21 17a9 9 0 0 0-15-6.7L3 13" />
            break;
        case "users":
            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
            <circle cx="9" cy="7" r="4" />
            <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
            <path d="M16 3.13a4 4 0 0 1 0 7.75" />
            break;
        case "shield":
            <path d="M12 2 4 5v6c0 5.25 3.44 9.75 8 11 4.56-1.25 8-5.75 8-11V5z" />
            break;
        case "warehouse":
            <path d="M2 9 12 3l10 6" />
            <path d="M4 9v11a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1V9" />
            <line x1="9" y1="21" x2="9" y2="13" />
            <line x1="15" y1="21" x2="15" y2="13" />
            <line x1="9" y1="13" x2="15" y2="13" />
            break;
        case "globe":
            <circle cx="12" cy="12" r="10" />
            <line x1="2" y1="12" x2="22" y2="12" />
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
            break;
        case "menu":
            <line x1="3" y1="6" x2="21" y2="6" />
            <line x1="3" y1="12" x2="21" y2="12" />
            <line x1="3" y1="18" x2="21" y2="18" />
            break;
    }
</svg>

@code {
    [Parameter] public string Name { get; set; } = "box";
    [Parameter] public int Size { get; set; } = 20;
}
