@* Campo numérico entero con botones − y +. Se puede escribir (se aplica al salir del campo,
   para no pisar lo que se está tipeando) o ajustar de a uno con los botones. Úsese con
   @bind-Value. *@
<div class="qty-field">
    <input class="input" type="number" min="@Min" max="@Max" step="1" value="@Value" @onchange="AlEscribir" />
    <button type="button" class="btn btn-secondary qty-field-btn" aria-label="Restar uno" disabled="@(Value <= Min)" @onclick="() => CambiarAsync(Value - 1)"><Icon Name="minus" Size="14" /></button>
    <button type="button" class="btn btn-secondary qty-field-btn" aria-label="Sumar uno" disabled="@(Max is not null && Value >= Max)" @onclick="() => CambiarAsync(Value + 1)"><Icon Name="plus" Size="14" /></button>
</div>

@code {
    [Parameter] public int Value { get; set; }
    [Parameter] public EventCallback<int> ValueChanged { get; set; }
    [Parameter] public int Min { get; set; }
    [Parameter] public int? Max { get; set; }

    private async Task AlEscribir(ChangeEventArgs e)
        => await CambiarAsync(int.TryParse(e.Value?.ToString(), out var n) ? n : Min);

    private async Task CambiarAsync(int nuevo)
    {
        nuevo = Math.Max(Min, Max is { } tope ? Math.Min(nuevo, tope) : nuevo);
        Value = nuevo;
        await ValueChanged.InvokeAsync(nuevo);
    }
}
