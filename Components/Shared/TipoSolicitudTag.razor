@* Entrada en verde con flecha hacia adentro, Salida en naranja con flecha hacia afuera —
   misma paleta e íconos que TipoMovimientoTag, definida en .tag-entrada/.tag-salida. *@
<span class="tag @(Tipo == TipoSolicitud.Entrada ? "tag-entrada" : "tag-salida") tag-con-icono"><Icon Name="@(Tipo == TipoSolicitud.Entrada ? "log-in" : "log-out")" Size="13" />@Tipo</span>

@code {
    [Parameter, EditorRequired] public TipoSolicitud Tipo { get; set; }
}
