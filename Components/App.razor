@using Microsoft.AspNetCore.Http
@inject Inventory.Web.Services.Auth.AuthState AuthState

<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    @* Aplica el tema guardado ANTES del primer paint, para que no se vea un flash
       claro al recargar con el oscuro activo. *@
    <script>
        (function () {
            try {
                var t = localStorage.getItem("tema");
                if (t === "dark") document.documentElement.setAttribute("data-theme", "dark");
                // El login se ve oscuro la primera vez (sin preferencia guardada); no se
                // guarda, así el resto de la app sigue arrancando en claro.
                else if (t === null && location.pathname === "/") document.documentElement.setAttribute("data-theme", "dark");
            } catch (e) { }
        })();
    </script>
    <ResourcePreloader />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["Inventory.Web.styles.css"]" />
    <ImportMap />
    <HeadOutlet />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="js/descargas.js"></script>
    <script src="js/tema.js"></script>
</body>

</html>

@code {
    // Único lugar del árbol donde HttpContext todavía existe de forma confiable — App
    // renderiza antes que <Routes @rendermode="InteractiveServer"/>, así que esto corre
    // en el request HTTP normal (todavía sin circuito SignalR). Reconstruye la sesión
    // desde la cookie "token" (puesta por /login-cookie) ANTES de que MainLayout decida
    // si redirige a "/" por no estar logueado — así un F5 no desloguea.
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    protected override void OnInitialized()
    {
        if (AuthState.IsAuthenticated) return;

        var token = HttpContext?.Request.Cookies["token"];
        if (token is not null)
            AuthState.RestaurarDesdeToken(token);
    }
}
