@page "/"
@layout Layout.WelcomeLayout
@inject PaisApiClient PaisApi
@inject AuthState AuthState
@inject NavigationManager Nav

<PageTitle>Iniciar sesión — Inventario</PageTitle>

@* Fondo: depósito en perspectiva (login-fondo.svg) + un velo que lo oscurece o aclara según
   el tema. Para usar una foto real, cambiá la URL de .login-fondo en app.css. *@
<div class="login-screen">
    <div class="login-fondo" aria-hidden="true"></div>
    <div class="login-velo" aria-hidden="true"></div>

    @* Fijo arriba a la derecha, siempre visible — el toggle de tema no espera a que
       carguen los países, así se puede cambiar el tema antes de que el form esté listo. *@
    <div class="login-controles">
        <ThemeToggle />
        @if (_paises is not null)
        {
            <div style="position:relative">
                <button type="button" class="flag-dropdown-trigger" title="@(_paisSeleccionado?.Nombre ?? "País")" @onclick="() => _menuAbierto = !_menuAbierto">
                    <Bandera CodigoIso="@_paisSeleccionado?.CodigoIso" Width="22" />
                    <span>@_paisSeleccionado?.CodigoIso</span>
                    <span style="font-size:10px;opacity:.7">▾</span>
                </button>
                @if (_menuAbierto)
                {
                    <div class="flag-dropdown-menu">
                        @foreach (var p in _paises)
                        {
                            <button type="button" class="flag-dropdown-item" @onclick="() => Seleccionar(p)">
                                <Bandera CodigoIso="@p.CodigoIso" Width="20" />
                                <span>@p.Nombre</span>
                            </button>
                        }
                    </div>
                }
            </div>
        }
    </div>

    <div class="login-card">
        <img src="/img/nestle-logo-crema.png" alt="Nestlé" class="login-logo login-logo-oscuro" />
        <img src="/img/nestle-logo-marron.png" alt="Nestlé" class="login-logo login-logo-claro" />
        <h1 class="login-titulo">Inventario de Material Promocional</h1>

        @if (_paises is null)
        {
            <p class="login-cargando">Cargando…</p>
        }
        else
        {
            @* Form HTML nativo (no EditForm/@onclick) a propósito: el login tiene que
               terminar en un POST HTTP real a /login-cookie, no en un evento por SignalR —
               es el único lugar donde el servidor puede mandar un Set-Cookie (ver
               Program.cs). Por eso los campos son <input name="..."> planos, no
               @bind-Value: el navegador arma el body del POST solo, sin pasar por C#. *@
            <form method="post" action="/login-cookie" class="login-form">
                <input type="hidden" name="PaisId" value="@_modelo.PaisId" />

                <div class="login-campo">
                    <label for="email">Email</label>
                    <div class="login-input">
                        <span class="login-icono"><Icon Name="mail" Size="17" /></span>
                        <input id="email" name="Email" type="email" placeholder="nombre@empresa.com" autocomplete="username" required autofocus />
                    </div>
                </div>

                <div class="login-campo">
                    <label for="pass">Contraseña</label>
                    <div class="login-input">
                        <span class="login-icono"><Icon Name="lock" Size="17" /></span>
                        <input id="pass" name="Password" type="@(_mostrarPassword ? "text" : "password")" class="con-ojo" placeholder="••••••••" autocomplete="current-password" required />
                        <button type="button" class="login-ojo" @onclick="() => _mostrarPassword = !_mostrarPassword"
                                aria-label="@(_mostrarPassword ? "Ocultar contraseña" : "Mostrar contraseña")">
                            <Icon Name="@(_mostrarPassword ? "eye-off" : "eye")" Size="18" />
                        </button>
                    </div>
                </div>

                <label class="login-recordar">
                    <input type="checkbox" name="Recordar" value="true" />
                    Mantener sesión iniciada
                </label>

                @if (_error is not null)
                {
                    <p class="login-error" role="alert">@_error</p>
                }

                <button type="submit" class="login-boton">Ingresar</button>
            </form>
        }
    </div>

    <p class="login-pie">Material POP · Control de inventario</p>
</div>

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "error")]
    public string? ErrorQuery { get; set; }

    private List<PaisDto>? _paises;
    private PaisDto? _paisSeleccionado;
    private bool _menuAbierto;
    private bool _mostrarPassword;
    private readonly Modelo _modelo = new();
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        if (AuthState.IsAuthenticated)
        {
            Nav.NavigateTo(PaginaDeInicio());
            return;
        }

        // /login-cookie (Program.cs) redirige acá con ?error=1 si el email/contraseña
        // no matchean — mismo mensaje genérico que ya usaba ApiException para no revelar
        // si el email existe en otro país.
        if (ErrorQuery is not null)
            _error = ErrorQuery switch
            {
                "bloqueado" => "Demasiados intentos fallidos. Esperá unos minutos e intentá de nuevo.",
                "inactivo" => "Este usuario está desactivado. Contactá a un administrador.",
                _ => "Email o contraseña incorrectos.",
            };

        try
        {
            _paises = await PaisApi.ListarAsync();
            if (_paises.Count > 0)
                Seleccionar(_paises[0]);
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
            _paises = [];
        }
    }

    private void Seleccionar(PaisDto p)
    {
        _paisSeleccionado = p;
        _modelo.PaisId = p.Id;
        _menuAbierto = false;
    }

    // Quien no puede ver Inicio (rol Solicitante) entra derecho a lo único que le sirve:
    // sus propias solicitudes. El resto de los roles sigue yendo a Inicio como siempre.
    private string PaginaDeInicio() =>
        AuthState.HasPermission(Permisos.InicioVer) ? "/inicio" : "/solicitudes/mias";

    private class Modelo
    {
        public int PaisId { get; set; }
    }
}
