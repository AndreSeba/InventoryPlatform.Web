@page "/conteos/nuevo"
@inject ConteoApiClient ConteoApi
@inject ProductoApiClient ProductoApi
@inject CategoriaApiClient CategoriaApi
@inject NavigationManager Nav
@inject AuthState AuthState

<PageTitle>Nuevo conteo</PageTitle>

<div style="margin-bottom:14px">
    <BotonVolver Href="/conteos" Texto="Volver a conteos" />
</div>

<h1>Nuevo conteo</h1>
<p class="text-muted" style="margin-top:-6px">Elegí los productos a contar. Al crear el conteo se guarda la existencia actual de cada ubicación y recién ahí podés descargar el Excel.</p>

@if (!AuthState.HasPermission(Permisos.ConteosRegistrar))
{
    <p class="dialog-error">No tenés permiso para crear conteos.</p>
}
else if (_productos is null || _categorias is null)
{
    <p>Cargando…</p>
}
else
{
    <div class="card elev-sm" style="margin:20px 0">
        <div class="field" style="max-width:420px;margin-bottom:12px">
            <label>Nombre del conteo (opcional)</label>
            <input class="input" maxlength="150" placeholder="Ej. Inventario mensual — rack A" @bind="_nombre" @bind:event="oninput" />
        </div>
        <div class="field" style="max-width:640px">
            <label>Notas (opcional)</label>
            <input class="input" maxlength="500" placeholder="Algo que quieras dejar anotado" @bind="_notas" @bind:event="oninput" />
        </div>
    </div>

    <div class="card elev-sm" style="margin:20px 0">
        <h2 style="margin:0 0 4px">Productos a contar</h2>
        <p class="card-body" style="margin:0 0 8px">Marcá <strong>uno por uno</strong> los productos. El conteo trae una fila por cada producto y ubicación donde tenga stock ahora mismo. Nunca se arma con el catálogo completo: un conteo físico se hace sobre un conjunto acotado.</p>

        <div class="filter-row">
            @* Categoría y búsqueda solo FILTRAN la lista de abajo: no seleccionan nada
               por sí solas. La selección siempre es marcando productos. *@
            <select class="input" style="max-width:220px" @bind="_categoriaId">
                <option value="0">Todas las categorías</option>
                @foreach (var c in _categorias)
                {
                    <option value="@c.Id">@c.CodigoCategoria</option>
                }
            </select>

            <input class="input" style="max-width:260px" placeholder="Buscar código o nombre…"
                   value="@_buscar" @oninput="e => _buscar = e.Value?.ToString() ?? string.Empty" />

            <button type="button" class="btn btn-primary" disabled="@(_creando || _seleccionados.Count == 0)" @onclick="CrearAsync">
                @(_creando ? "Creando…" : $"Crear conteo ({_seleccionados.Count})")
            </button>
        </div>

        <div style="display:flex;align-items:center;justify-content:space-between;margin-top:10px">
            <span class="text-muted" style="font-size:13px">
                @if (_seleccionados.Count == 0)
                {
                    <span>Ningún producto seleccionado todavía.</span>
                }
                else
                {
                    <span><strong>@_seleccionados.Count</strong> producto(s) seleccionado(s).</span>
                }
            </span>
            @if (_seleccionados.Count > 0)
            {
                <button type="button" class="btn btn-ghost btn-sm" @onclick="() => _seleccionados.Clear()">Limpiar selección</button>
            }
        </div>

        <div class="sel-lista">
            @* Se llama dos veces en vez de guardar en una variable con un bloque de código: ese bloque,
               abierto después de markup dentro del else de arriba, rompe la compilación
               con RZ1010 (ver CLAUDE.md). La lista está en memoria, no cuesta nada. *@
            @if (ProductosFiltrados().Count == 0)
            {
                <p class="text-muted" style="font-size:13px;margin:8px">Ningún producto coincide con el filtro.</p>
            }
            @foreach (var p in ProductosFiltrados())
            {
                <label class="sel-prod @(_seleccionados.Contains(p.Id) ? "on" : "") @(p.Existencia <= 0 ? "off" : "")">
                    <input type="checkbox" disabled="@(p.Existencia <= 0)" checked="@_seleccionados.Contains(p.Id)" @onchange="@(e => Alternar(p.Id, e.Value))" />
                    @if (string.IsNullOrWhiteSpace(p.ImagenUrl))
                    {
                        <span class="sel-prod-img"><Icon Name="package" Size="20" /></span>
                    }
                    else
                    {
                        @* loading=lazy: la lista trae todo el catálogo; solo se bajan las fotos que se ven. *@
                        <img class="sel-prod-img" loading="lazy" decoding="async" alt="" src="@($"{ProductoApi.ApiBaseUrl}{p.ImagenUrl}")" />
                    }
                    <span class="sel-prod-texto">
                        <span class="sel-prod-nombre"><strong>@p.CodigoProducto</strong> — @p.Nombre</span>
                        <span class="sel-prod-meta">@p.CategoriaNombre</span>
                    </span>
                    <span class="sel-prod-stock @(p.Existencia <= 0 ? "sin" : "")">@(p.Existencia <= 0 ? "Sin stock" : $"{p.Existencia:N0} {p.UnidadMedida}")</span>
                </label>
            }
        </div>

        @if (_error is not null)
        {
            <p class="dialog-error">@_error</p>
        }
    </div>
}

@code {
    private List<ProductoDto>? _productos;
    private List<CategoriaDto>? _categorias;
    private readonly HashSet<int> _seleccionados = [];

    private string _nombre = "";
    private string _notas = "";
    private int _categoriaId;
    private string _buscar = "";
    private bool _creando;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        if (!AuthState.HasPermission(Permisos.ConteosRegistrar)) return;

        try
        {
            var productos = ProductoApi.ListarAsync();
            var categorias = CategoriaApi.ListarAsync();
            await Task.WhenAll(productos, categorias);
            _productos = productos.Result;
            _categorias = categorias.Result;
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
            _productos = [];
            _categorias = [];
        }
    }

    // Categoría y búsqueda solo acotan lo que se ve; lo que entra en el conteo es siempre
    // lo que está tildado en _seleccionados.
    private List<ProductoDto> ProductosFiltrados()
    {
        var q = _buscar.Trim();
        return (_productos ?? [])
            .Where(p => _categoriaId <= 0 || p.CategoriaId == _categoriaId)
            .Where(p => q.Length == 0
                || p.CodigoProducto.Contains(q, StringComparison.OrdinalIgnoreCase)
                || p.Nombre.Contains(q, StringComparison.OrdinalIgnoreCase))
            .ToList();
    }

    private void Alternar(int productoId, object? valorChecked)
    {
        if (valorChecked is bool marcado && marcado) _seleccionados.Add(productoId);
        else _seleccionados.Remove(productoId);
    }

    private async Task CrearAsync()
    {
        if (_creando) return;
        _error = null;

        if (_seleccionados.Count == 0)
        {
            _error = "Seleccioná al menos un producto.";
            return;
        }

        _creando = true;
        try
        {
            var creado = await ConteoApi.CrearAsync(new CrearConteoDto(_nombre, _notas, _seleccionados.ToList()));
            Nav.NavigateTo($"/conteos/{creado.Resumen.Id}");
        }
        catch (ApiException ex) { _error = ex.Message; }
        finally { _creando = false; }
    }
}
