@page "/conteos"
@inject ConteoApiClient ConteoApi
@inject ProductoApiClient ProductoApi
@inject UbicacionApiClient UbicacionApi

<PageTitle>Conteo físico</PageTitle>

<h1>Conteo físico</h1>
<p class="text-muted" style="margin-top:-6px">Registre el conteo por sesión y compare contra la existencia calculada por el sistema.</p>

@if (_error is not null)
{
    <p class="dialog-error">@_error</p>
}
@if (_ok is not null)
{
    <p style="color:var(--color-accent-700);font-size:13px">@_ok</p>
}

<div class="field" style="max-width:320px;margin:20px 0">
    <label>Sesión de conteo</label>
    <input class="input" value="@_sesion" placeholder="Ej. INVENTARIO-2026-09" @oninput="OnSesionInput" />
</div>

@if (_productos is null || _ubicaciones is null)
{
    <p>Cargando…</p>
}
else
{
    <div class="filter-row" style="margin-bottom:24px">
        <select class="input" style="max-width:260px" @bind="_productoId">
            <option value="0">-- Producto --</option>
            @foreach (var p in _productos)
            {
                <option value="@p.Id">@p.CodigoProducto — @p.Nombre</option>
            }
        </select>
        <select class="input" style="max-width:180px" @bind="_ubicacionId">
            <option value="0">-- Ubicación --</option>
            @foreach (var u in _ubicaciones)
            {
                <option value="@u.Id">@u.CodigoUbicacion</option>
            }
        </select>
        <input class="input" style="max-width:90px" type="number" min="1" title="N.º de conteo" @bind="_numeroConteo" />
        <input class="input" style="max-width:150px" type="number" min="0" step="0.01" placeholder="Cantidad contada" @bind="_cantidadContada" />
        <button type="button" class="btn btn-primary" disabled="@_guardando" @onclick="RegistrarAsync">@(_guardando ? "Guardando…" : "Registrar")</button>
    </div>
}

@if (string.IsNullOrWhiteSpace(_sesion))
{
    <p class="text-muted">Escribí un nombre de sesión para ver los conteos ya cargados.</p>
}
else if (_conteos is null)
{
    <p>Cargando…</p>
}
else if (_conteos.Count == 0)
{
    <p class="text-muted">Todavía no hay conteos en esta sesión.</p>
}
else
{
    <div class="table-wrap">
        <table class="table">
            <thead><tr><th>Producto</th><th>Ubicación</th><th>N.º</th><th>Contado</th><th>Sistema</th><th>Diferencia</th></tr></thead>
            <tbody>
                @foreach (var c in _conteos)
                {
                    <tr>
                        <td>@c.ProductoNombre</td>
                        <td class="text-muted">@c.UbicacionCodigo</td>
                        <td class="text-muted">@c.NumeroConteo</td>
                        <td>@c.CantidadContada.ToString("N2")</td>
                        <td class="text-muted">@c.ExistenciaSistema.ToString("N2")</td>
                        <td><span class="@(c.Diferencia != 0 ? "tag tag-warn" : "tag tag-neutral")">@c.Diferencia.ToString("N2")</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<ProductoDto>? _productos;
    private List<UbicacionDto>? _ubicaciones;
    private List<ConteoDto>? _conteos;

    private string _sesion = "";
    private int _productoId;
    private int _ubicacionId;
    private int _numeroConteo = 1;
    private decimal _cantidadContada;
    private bool _guardando;
    private string? _error;
    private string? _ok;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _productos = await ProductoApi.ListarAsync();
            _ubicaciones = await UbicacionApi.ListarAsync();
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
            _productos = [];
            _ubicaciones = [];
        }
    }

    private async Task OnSesionInput(ChangeEventArgs e)
    {
        _sesion = e.Value?.ToString() ?? "";
        await CargarSesionAsync();
    }

    private async Task CargarSesionAsync()
    {
        if (string.IsNullOrWhiteSpace(_sesion)) { _conteos = null; return; }

        try { _conteos = await ConteoApi.ListarPorSesionAsync(_sesion); }
        catch (ApiException ex) { _error = ex.Message; _conteos = []; }
    }

    private async Task RegistrarAsync()
    {
        if (_guardando) return;
        if (string.IsNullOrWhiteSpace(_sesion)) { _error = "Indicá la sesión de conteo."; return; }
        if (_productoId <= 0) { _error = "Seleccioná un producto."; return; }
        if (_ubicacionId <= 0) { _error = "Seleccioná una ubicación."; return; }

        _guardando = true;
        _error = null;
        _ok = null;

        try
        {
            await ConteoApi.RegistrarAsync(new RegistrarConteoDto(_sesion, _productoId, _ubicacionId, _numeroConteo, _cantidadContada));
            _ok = "Conteo registrado.";
            _cantidadContada = 0;
            await CargarSesionAsync();
        }
        catch (ApiException ex) { _error = ex.Message; }
        finally { _guardando = false; }
    }
}
