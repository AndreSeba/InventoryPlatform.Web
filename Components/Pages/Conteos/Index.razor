@page "/conteos"
@inject ConteoApiClient ConteoApi
@inject NavigationManager Nav
@inject AuthState AuthState

<PageTitle>Conteo físico</PageTitle>

<div class="page-head">
    <div>
        <h1>Conteo físico</h1>
        <p class="text-muted" style="margin-top:-6px">Cada conteo queda registrado: qué se contó, quién lo hizo y el documento físico que lo respalda.</p>
    </div>
    @if (AuthState.HasPermission(Permisos.ConteosRegistrar))
    {
        <button type="button" class="btn btn-primary" @onclick='() => Nav.NavigateTo("/conteos/nuevo")'><Icon Name="plus" Size="16" />Nuevo conteo</button>
    }
</div>

@if (_error is not null)
{
    <p class="dialog-error">@_error</p>
}

@if (_conteos is null)
{
    <p>Cargando…</p>
}
else
{
    <div class="filter-row">
        <div class="chip-row">
            <button type="button" class="btn @(_filtro is null ? "btn-primary" : "btn-secondary")" @onclick="() => SetFiltro(null)">Todos</button>
            <button type="button" class="btn @(_filtro == EstadoConteo.EnCurso ? "btn-primary" : "btn-secondary")" @onclick="() => SetFiltro(EstadoConteo.EnCurso)"><Icon Name="clock" Size="14" />En curso</button>
            <button type="button" class="btn @(_filtro == EstadoConteo.Cerrado ? "btn-primary" : "btn-secondary")" @onclick="() => SetFiltro(EstadoConteo.Cerrado)"><Icon Name="check-circle" Size="14" />Cerrados</button>
            <button type="button" class="btn @(_filtro == EstadoConteo.Cancelado ? "btn-primary" : "btn-secondary")" @onclick="() => SetFiltro(EstadoConteo.Cancelado)"><Icon Name="x-circle" Size="14" />Cancelados</button>
        </div>
    </div>

    @if (Filtrados().Count == 0)
    {
        <p class="text-muted" style="margin-top:20px">
            @(_conteos.Count == 0 ? "Todavía no hay conteos. Creá el primero con «Nuevo conteo»." : "No hay conteos con ese filtro.")
        </p>
    }
    else
    {
        <div class="table-wrap">
            <table class="table">
                <thead><tr><th>Conteo</th><th>Estado</th><th>Avance</th><th>Diferencias</th><th>Evidencia</th><th>Creado por</th><th>Fecha</th><th></th></tr></thead>
                <tbody>
                    @foreach (var c in Paginados())
                    {
                        <tr>
                            <td>
                                <div class="sol-num">@c.Codigo</div>
                                @if (!string.IsNullOrWhiteSpace(c.Nombre))
                                {
                                    <div class="text-muted" style="font-size:12px">@c.Nombre</div>
                                }
                            </td>
                            <td><EstadoConteoBadge Estado="c.Estado" /></td>
                            <td class="text-muted">@c.LineasContadas / @c.TotalLineas</td>
                            <td>
                                @if (c.Estado == EstadoConteo.Cancelado || c.LineasContadas == 0)
                                {
                                    <span class="text-muted">—</span>
                                }
                                else if (c.LineasConDiferencia > 0)
                                {
                                    <span class="tag tag-warn tag-con-icono"><Icon Name="alert" Size="13" />@c.LineasConDiferencia</span>
                                }
                                else
                                {
                                    <span class="tag tag-success tag-con-icono"><Icon Name="check" Size="13" />Sin diferencias</span>
                                }
                            </td>
                            <td class="text-muted">@(c.CantidadEvidencias == 0 ? "—" : $"{c.CantidadEvidencias} archivo(s)")</td>
                            <td><AvatarNombre Nombre="@c.CreadoPor" /></td>
                            <td class="text-muted">@c.FechaCreacion.ToLocalTime().ToString("dd/MM/yyyy")</td>
                            <td><button type="button" class="btn btn-icon-outline btn-icon-outline-accent" title="Ver" @onclick="() => Ver(c.Id)"><Icon Name="eye" Size="16" /></button></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <Pager TotalItems="Filtrados().Count" PaginaActual="_pagina" PaginaActualChanged="p => _pagina = p" TamanoPagina="TamanoPagina" />
    }
}

@code {
    private List<ConteoResumenDto>? _conteos;
    private EstadoConteo? _filtro;
    private string? _error;

    private const int TamanoPagina = 10;
    private int _pagina = 1;

    protected override async Task OnInitializedAsync()
    {
        try { _conteos = await ConteoApi.ListarAsync(); }
        catch (ApiException ex) { _error = ex.Message; _conteos = []; }
    }

    private void SetFiltro(EstadoConteo? estado)
    {
        _filtro = estado;
        _pagina = 1;
    }

    private List<ConteoResumenDto> Filtrados() => (_conteos ?? [])
        .Where(c => _filtro is null || c.Estado == _filtro)
        .ToList();

    private List<ConteoResumenDto> Paginados() => Filtrados()
        .Skip((_pagina - 1) * TamanoPagina)
        .Take(TamanoPagina)
        .ToList();

    private void Ver(int id) => Nav.NavigateTo($"/conteos/{id}");
}
