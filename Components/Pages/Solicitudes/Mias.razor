@page "/solicitudes/mias"
@inject SolicitudApiClient SolicitudApi
@inject NavigationManager Nav
@inject AuthState AuthState

<PageTitle>Mis solicitudes</PageTitle>

<div class="page-head">
    <div>
        <h1>Mis solicitudes</h1>
        <p class="text-muted" style="margin-top:-6px">Tus pedidos de material promocional — solo los que creaste vos.</p>
    </div>
    @if (AuthState.HasPermission(Permisos.SolicitudesCrear))
    {
        <button type="button" class="btn btn-primary" @onclick="IrANueva">+ Nueva solicitud</button>
    }
</div>

@if (_error is not null)
{
    <p class="dialog-error">@_error</p>
}

@if (_solicitudes is null)
{
    <p>Cargando…</p>
}
else
{
    <div class="filter-row">
        <div class="chip-row">
            <button type="button" class="btn @(_filtroEstado == "" ? "btn-primary" : "btn-secondary")" @onclick='() => SetFiltro("")'>Todas</button>
            <button type="button" class="btn @(_filtroEstado == "Pendiente" ? "btn-primary" : "btn-secondary")" @onclick='() => SetFiltro("Pendiente")'><Icon Name="clock" Size="14" />Pendiente</button>
            <button type="button" class="btn @(_filtroEstado == "Aprobada" ? "btn-primary" : "btn-secondary")" @onclick='() => SetFiltro("Aprobada")'><Icon Name="check-circle" Size="14" />Aprobada</button>
            <button type="button" class="btn @(_filtroEstado == "EntregadaParcial" ? "btn-primary" : "btn-secondary")" @onclick='() => SetFiltro("EntregadaParcial")'><Icon Name="package" Size="14" />Entregada parcial</button>
            <button type="button" class="btn @(_filtroEstado == "Entregada" ? "btn-primary" : "btn-secondary")" @onclick='() => SetFiltro("Entregada")'><Icon Name="check-circle" Size="14" />Entregada</button>
            <button type="button" class="btn @(_filtroEstado == "Rechazada" ? "btn-primary" : "btn-secondary")" @onclick='() => SetFiltro("Rechazada")'><Icon Name="x-circle" Size="14" />Rechazada</button>
        </div>
    </div>

    @if (_solicitudes.Count == 0)
    {
        <p class="text-muted" style="margin-top:20px">Todavía no creaste ninguna solicitud con ese filtro.</p>
    }
    else
    {
        <div class="table-wrap">
            <table class="table">
                <thead><tr><th>N.º</th><th>Área</th><th>Tipo</th><th>Estado</th><th>Fecha</th><th></th></tr></thead>
                <tbody>
                    @foreach (var s in Paginados())
                    {
                        <tr>
                            <td class="sol-num">@s.NumeroSolicitud</td>
                            <td>@s.AreaNombre</td>
                            <td><TipoSolicitudTag Tipo="s.Tipo" /></td>
                            <td><EstadoSolicitudBadge Estado="s.Estado" /></td>
                            <td class="text-muted">@s.FechaSolicitud.ToLocalTime().ToString("dd/MM/yyyy")</td>
                            <td><button type="button" class="btn btn-icon-outline btn-icon-outline-accent" title="Ver" @onclick="() => VerSolicitud(s.Id)"><Icon Name="eye" Size="16" /></button></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <Pager TotalItems="_solicitudes.Count" PaginaActual="_pagina" PaginaActualChanged="p => _pagina = p" TamanoPagina="TamanoPagina" />
    }
}

@code {
    private List<SolicitudDto>? _solicitudes;
    private string _filtroEstado = "";
    private string? _error;

    private const int TamanoPagina = 10;
    private int _pagina = 1;

    private List<SolicitudDto> Paginados() => (_solicitudes ?? [])
        .Skip((_pagina - 1) * TamanoPagina)
        .Take(TamanoPagina)
        .ToList();

    protected override async Task OnInitializedAsync() => await CargarAsync();

    private async Task CargarAsync()
    {
        try
        {
            _solicitudes = await SolicitudApi.ListarMiasAsync(string.IsNullOrEmpty(_filtroEstado) ? null : _filtroEstado);
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
            _solicitudes = [];
        }
    }

    private void VerSolicitud(int id) => Nav.NavigateTo($"/solicitudes/{id}");
    private void IrANueva() => Nav.NavigateTo("/solicitudes/nueva");

    private async Task SetFiltro(string estado)
    {
        _filtroEstado = estado;
        _pagina = 1;
        try { _solicitudes = await SolicitudApi.ListarMiasAsync(string.IsNullOrEmpty(estado) ? null : estado); }
        catch (ApiException ex) { _error = ex.Message; }
    }

}
