@page "/solicitudes/{Id:int}"
@inject SolicitudApiClient SolicitudApi
@inject MovimientoApiClient MovimientoApi
@inject UbicacionApiClient UbicacionApi
@inject AuthState AuthState
@inject IJSRuntime JS

<PageTitle>Solicitud</PageTitle>

<a href="@(AuthState.HasPermission(Permisos.SolicitudesVer) ? "/solicitudes" : "/solicitudes/mias")" class="no-print" style="font-size:13px">‹ Volver a solicitudes</a>

@if (_error is not null)
{
    <p class="dialog-error no-print">@_error</p>
}
@if (_ok is not null)
{
    <p class="no-print" style="color:var(--color-accent-700);font-size:13px">@_ok</p>
}

@if (_solicitud is null || _ubicaciones is null)
{
    <p>Cargando…</p>
}
else
{
    <div class="page-head no-print" style="margin-top:12px">
        <div>
            <h1 style="margin-bottom:4px">Solicitud @_solicitud.NumeroSolicitud</h1>
            <p class="text-muted" style="margin:0">@_solicitud.AreaNombre · Solicitado por @_solicitud.SolicitadoPor</p>
        </div>
        <div style="display:flex;gap:8px;align-items:center">
            <span class="@(_solicitud.Tipo == TipoSolicitud.Entrada ? "tag tag-accent" : "tag tag-outline")" style="font-size:13px;padding:6px 14px">@_solicitud.Tipo</span>
            <span class="@EstadoTagClase(_solicitud.Estado)" style="font-size:13px;padding:6px 14px">@_solicitud.Estado</span>
        </div>
    </div>

    @if (_solicitud.Estado == EstadoSolicitud.Rechazada)
    {
        <p class="dialog-error no-print">Motivo de rechazo: @_solicitud.MotivoRechazo</p>
    }

    <div class="table-wrap no-print" style="margin-top:20px">
        <table class="table">
            <thead>
                <tr>
                    <th>Producto</th><th>Solicitada</th><th>Aprobada</th><th>Entregada</th>
                    @if (_solicitud.Estado == EstadoSolicitud.Pendiente && AuthState.HasPermission(Permisos.SolicitudesAprobar))
                    {
                        <th>Aprobar cantidad</th>
                    }
                    else if (_solicitud.Estado is EstadoSolicitud.Aprobada or EstadoSolicitud.EntregadaParcial && AuthState.HasPermission(Permisos.SolicitudesEntregar))
                    {
                        <th>@(_solicitud.Tipo == TipoSolicitud.Entrada ? "Registrar recepción" : "Entregar")</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var d in _solicitud.Detalles)
                {
                    <tr>
                        <td>
                            @d.ProductoNombre
                            @if (d.Retorna)
                            {
                                <span class="tag tag-outline" style="margin-left:6px;font-size:11px">Retorna</span>
                            }
                        </td>
                        <td>@d.CantidadSolicitada.ToString("N0")</td>
                        <td class="text-muted">@(d.CantidadAprobada?.ToString("N0") ?? "—")</td>
                        <td class="text-muted">@d.CantidadEntregada.ToString("N0")</td>
                        @if (_solicitud.Estado == EstadoSolicitud.Pendiente && AuthState.HasPermission(Permisos.SolicitudesAprobar))
                        {
                            <td><input class="input" style="max-width:110px" type="number" min="0" step="1" @bind="_cantidadAprobada[d.Id]" /></td>
                        }
                        else if (_solicitud.Estado is EstadoSolicitud.Aprobada or EstadoSolicitud.EntregadaParcial && d.CantidadAprobada > d.CantidadEntregada && AuthState.HasPermission(Permisos.SolicitudesEntregar))
                        {
                            <td>
                                <div style="display:flex;gap:8px;align-items:center">
                                    <input class="input" style="max-width:90px" type="number" min="0" step="1" @bind="_cantidadEntrega[d.Id]" />
                                    <select class="input" style="max-width:130px" @bind="_ubicacionEntrega[d.Id]">
                                        <option value="0">@(_solicitud.Tipo == TipoSolicitud.Entrada ? "Ubicación destino…" : "Ubicación…")</option>
                                        @foreach (var u in _ubicaciones)
                                        {
                                            <option value="@u.Id">@u.CodigoUbicacion</option>
                                        }
                                    </select>
                                    <button type="button" class="btn btn-secondary btn-sm" disabled="@_guardando" @onclick="() => EntregarAsync(d.Id)">@(_solicitud.Tipo == TipoSolicitud.Entrada ? "Registrar recepción" : "Entregar")</button>
                                </div>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (_solicitud.Estado == EstadoSolicitud.Pendiente && (AuthState.HasPermission(Permisos.SolicitudesAprobar) || AuthState.HasPermission(Permisos.SolicitudesRechazar)))
    {
        <div class="no-print" style="display:flex;gap:12px;align-items:center;margin-top:20px;flex-wrap:wrap">
            @if (AuthState.HasPermission(Permisos.SolicitudesAprobar))
            {
                <button type="button" class="btn btn-primary" disabled="@_guardando" @onclick="AprobarAsync">Aprobar solicitud</button>
            }
            @if (AuthState.HasPermission(Permisos.SolicitudesRechazar))
            {
                <input class="input" style="max-width:300px" placeholder="Motivo de rechazo" @bind="_motivoRechazo" />
                <button type="button" class="btn btn-ghost" style="color:#b42318" disabled="@_guardando" @onclick="RechazarAsync">Rechazar</button>
            }
        </div>
    }

    <div class="hr no-print" style="margin-top:36px"></div>
    <h3 class="no-print">Formulario imprimible</h3>
    <div class="printable printable-form">
        <div class="printable-form-fecha">
            <span class="pf-label">Fecha:</span>
            <span class="pf-fecha-value">@_solicitud.FechaSolicitud.ToLocalTime().ToString("d/M/yyyy")</span>
        </div>
        <p class="printable-form-title">FORMULARIO<br />SOLICITUD MATERIAL PUBLICITARIO</p>

        <div class="printable-form-checks">
            <span>Movimiento :</span>
            <span>@(_solicitud.Tipo == TipoSolicitud.Entrada ? "☑" : "☐") ENTRADA</span>
            <span>@(_solicitud.Tipo == TipoSolicitud.Salida ? "☑" : "☐") SALIDA</span>
        </div>
        <div class="printable-form-row">
            <div class="pf-label">Solicitante:</div>
            <div class="pf-value">@_solicitud.SolicitadoPor</div>
        </div>
        <div class="printable-form-row">
            <div class="pf-label">Autorizado por:</div>
            <div class="pf-value">@(_solicitud.AprobadoPor ?? "")</div>
        </div>
        <div class="printable-form-row">
            <div class="pf-label">Categoria</div>
            <div class="pf-value">@_solicitud.AreaNombre</div>
        </div>

        <div class="printable-form-table-wrap">
            <table class="printable-form-table">
                <thead>
                    <tr><th>CODIGO</th><th>DESCRIPCION</th><th>CANTIDAD</th><th>UME</th><th>Costo unit.</th><th>LOTE</th></tr>
                </thead>
                <tbody>
                    @foreach (var d in _solicitud.Detalles)
                    {
                        <tr>
                            <td>@d.ProductoCodigo</td>
                            <td>@d.ProductoNombre</td>
                            <td>@d.CantidadSolicitada.ToString("N0")</td>
                            <td>@d.UnidadMedida</td>
                            <td>@(d.CostoUnitario is null ? "" : d.CostoUnitario.Value.ToString("N2"))</td>
                            <td></td>
                        </tr>
                    }
                    @for (var i = _solicitud.Detalles.Count; i < FilasMinimasTabla; i++)
                    {
                        <tr><td></td><td></td><td></td><td></td><td></td><td></td></tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="printable-form-motivo">
            <span class="pf-label">Motivo / Observaciones:</span>
            <span>@(_solicitud.Estado == EstadoSolicitud.Rechazada ? _solicitud.MotivoRechazo : "")</span>
        </div>

        <div class="printable-form-firmas">
            <div>NOMBRE Y FIRMA<br />PROVEEDOR/SOLICITANTE</div>
            <div>FIRMA ALMACÉN</div>
        </div>
    </div>
    <button type="button" class="btn btn-primary no-print" style="margin-top:16px" @onclick="Imprimir">
        <Icon Name="print" Size="14" />
        Imprimir formulario
    </button>
}

@code {
    [Parameter] public int Id { get; set; }

    private SolicitudDto? _solicitud;
    private List<UbicacionDto>? _ubicaciones;
    private readonly Dictionary<int, int> _cantidadAprobada = new();
    private readonly Dictionary<int, int> _cantidadEntrega = new();
    private readonly Dictionary<int, int> _ubicacionEntrega = new();
    private string? _motivoRechazo;
    private bool _guardando;
    private string? _error;
    private string? _ok;

    protected override async Task OnInitializedAsync() => await CargarAsync();

    private async Task CargarAsync()
    {
        try
        {
            _solicitud = await SolicitudApi.ObtenerPorIdAsync(Id);
            _ubicaciones = await UbicacionApi.ListarAsync();
            if (_solicitud is not null)
                foreach (var d in _solicitud.Detalles)
                {
                    // Las 3 se pre-cargan acá, no donde se usan — @bind lee la clave del
                    // diccionario directo (no GetValueOrDefault), y la tabla puede pasar de
                    // mostrar "Aprobar cantidad" a "Entregar" dentro del MISMO circuito
                    // (justo después de aprobar, sin recargar la página). Si _cantidadEntrega/
                    // _ubicacionEntrega no tienen la clave todavía en ese momento, el @bind
                    // revienta con KeyNotFoundException y tira abajo el circuito entero.
                    _cantidadAprobada.TryAdd(d.Id, d.CantidadSolicitada);
                    _cantidadEntrega.TryAdd(d.Id, 0);
                    _ubicacionEntrega.TryAdd(d.Id, 0);
                }
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
    }

    private async Task AprobarAsync()
    {
        if (_guardando || _solicitud is null) return;
        _guardando = true;
        _error = null;

        try
        {
            var lineas = _solicitud.Detalles
                .Select(d => new AprobarSolicitudDetalleDto(d.Id, _cantidadAprobada.GetValueOrDefault(d.Id)))
                .Where(l => l.CantidadAprobada > 0)
                .ToList();

            _solicitud = await SolicitudApi.AprobarAsync(Id, new AprobarSolicitudDto(lineas));
            _ok = "Solicitud aprobada.";
        }
        catch (ApiException ex) { _error = ex.Message; }
        finally { _guardando = false; }
    }

    private async Task RechazarAsync()
    {
        if (_guardando) return;
        if (string.IsNullOrWhiteSpace(_motivoRechazo)) { _error = "Indicá el motivo de rechazo."; return; }

        _guardando = true;
        _error = null;

        try
        {
            _solicitud = await SolicitudApi.RechazarAsync(Id, new RechazarSolicitudDto(_motivoRechazo));
            _ok = "Solicitud rechazada.";
        }
        catch (ApiException ex) { _error = ex.Message; }
        finally { _guardando = false; }
    }

    private async Task EntregarAsync(int solicitudDetalleId)
    {
        if (_guardando || _solicitud is null) return;

        var detalle = _solicitud.Detalles.First(d => d.Id == solicitudDetalleId);
        var cantidad = _cantidadEntrega.GetValueOrDefault(solicitudDetalleId);
        var ubicacionId = _ubicacionEntrega.GetValueOrDefault(solicitudDetalleId);

        if (cantidad <= 0) { _error = "Indicá la cantidad a entregar."; return; }
        if (ubicacionId <= 0) { _error = "Seleccioná desde qué ubicación sale."; return; }

        _guardando = true;
        _error = null;

        try
        {
            if (_solicitud.Tipo == TipoSolicitud.Entrada)
            {
                await MovimientoApi.RegistrarEntradaAsync(new RegistrarEntradaDto(
                    detalle.ProductoId, ubicacionId, cantidad, $"Recepción solicitud {_solicitud.NumeroSolicitud}", solicitudDetalleId));
                _ok = "Recepción registrada.";
            }
            else
            {
                await MovimientoApi.RegistrarSalidaAsync(new RegistrarSalidaDto(
                    detalle.ProductoId, ubicacionId, cantidad, $"Entrega solicitud {_solicitud.NumeroSolicitud}",
                    detalle.Retorna, detalle.Retorna ? detalle.UbicacionExterna : null,
                    detalle.Retorna ? detalle.FechaRetornoEsperada : null, solicitudDetalleId));
                _ok = "Entrega registrada.";
            }

            await CargarAsync();
        }
        catch (ApiException ex) { _error = ex.Message; }
        finally { _guardando = false; }
    }

    private const int FilasMinimasTabla = 32;

    private async Task Imprimir() => await JS.InvokeVoidAsync("print");

    private static string EstadoTagClase(EstadoSolicitud e) => e switch
    {
        EstadoSolicitud.Pendiente => "tag tag-warn",
        EstadoSolicitud.Aprobada or EstadoSolicitud.EntregadaParcial => "tag tag-outline",
        EstadoSolicitud.Entregada => "tag tag-accent",
        EstadoSolicitud.Rechazada => "tag tag-neutral",
        _ => "tag tag-neutral",
    };
}
