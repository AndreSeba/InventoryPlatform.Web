@page "/solicitudes/{Id:int}"
@inject SolicitudApiClient SolicitudApi
@inject ProductoApiClient ProductoApi
@inject AuthState AuthState
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>Solicitud</PageTitle>

<div style="margin-bottom:14px">
    <BotonVolver Href="@(AuthState.HasPermission(Permisos.SolicitudesVer) ? "/solicitudes" : "/solicitudes/mias")" Texto="Volver a solicitudes" />
</div>

@if (_error is not null)
{
    <p class="dialog-error no-print">@_error</p>
}
@if (_ok is not null)
{
    <p class="no-print" style="color:var(--color-accent-700);font-size:13px">@_ok</p>
}

@if (_solicitud is null)
{
    <p>Cargando…</p>
}
else
{
    var estado = EstadoBadge(_solicitud.Estado);

    <div class="card elev-sm sol-card no-print">
        <div class="sol-head">
            <h1 class="sol-number">@_solicitud.NumeroSolicitud</h1>
            <span class="tag @estado.Clase sol-estado"><Icon Name="@estado.Icono" Size="14" />@estado.Texto</span>
        </div>

        <div class="sol-meta">
            <div>
                <div class="sol-meta-label"><Icon Name="user" Size="14" />Solicitado por</div>
                <div class="sol-meta-value"><span class="avatar">@Iniciales(_solicitud.SolicitadoPor)</span>@_solicitud.SolicitadoPor</div>
            </div>
            <div>
                <div class="sol-meta-label"><Icon Name="building" Size="14" />Área</div>
                <div class="sol-meta-value"><Icon Name="building" Size="16" />@_solicitud.AreaNombre</div>
            </div>
            <div>
                <div class="sol-meta-label"><Icon Name="calendar" Size="14" />Fecha</div>
                <div class="sol-meta-value"><Icon Name="calendar" Size="16" />@_solicitud.FechaSolicitud.ToLocalTime().ToString("d/M/yyyy")</div>
            </div>
            <div>
                <div class="sol-meta-label"><Icon Name="box" Size="14" />Tipo</div>
                <div class="sol-meta-value sol-tipo-@(_solicitud.Tipo == TipoSolicitud.Entrada ? "entrada" : "salida")">
                    <Icon Name="@(_solicitud.Tipo == TipoSolicitud.Entrada ? "log-in" : "log-out")" Size="16" />@_solicitud.Tipo
                </div>
            </div>
        </div>

        <div class="sol-lines">
            <table class="table">
                <thead>
                    <tr>
                        <th>Producto</th><th>Código</th><th>Descripción</th>
                        <th class="num">Solicitada</th><th class="num">Aprobada</th><th class="num">Entregada</th>
                        @if (_solicitud.Estado == EstadoSolicitud.Pendiente && AuthState.HasPermission(Permisos.SolicitudesAprobar))
                        {
                            <th>Aprobar cantidad</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in _solicitud.Detalles)
                    {
                        <tr>
                            <td>
                                <div class="sol-thumb" style="@(string.IsNullOrWhiteSpace(d.ImagenUrl) ? "" : $"background-image:url('{ProductoApi.ApiBaseUrl}{d.ImagenUrl}')")">
                                    @if (string.IsNullOrWhiteSpace(d.ImagenUrl))
                                    {
                                        <Icon Name="package" Size="18" />
                                    }
                                </div>
                            </td>
                            <td class="sol-code">@d.ProductoCodigo</td>
                            <td>
                                @d.ProductoNombre
                                @if (d.Retorna)
                                {
                                    <span class="tag tag-outline" style="margin-left:6px;font-size:11px">Retorna</span>
                                }
                            </td>
                            <td class="num">@d.CantidadSolicitada.ToString("N0")</td>
                            <td class="num text-muted">@(d.CantidadAprobada?.ToString("N0") ?? "—")</td>
                            <td class="num text-muted">@d.CantidadEntregada.ToString("N0")</td>
                            @if (_solicitud.Estado == EstadoSolicitud.Pendiente && AuthState.HasPermission(Permisos.SolicitudesAprobar))
                            {
                                <td><input class="input" style="max-width:110px" type="number" min="0" step="1" @bind="_cantidadAprobada[d.Id]" /></td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (_solicitud.Estado == EstadoSolicitud.Rechazada)
    {
        <p class="dialog-error no-print" style="margin-top:12px">Motivo de rechazo: @_solicitud.MotivoRechazo</p>
    }

    @if (_solicitud.Estado is EstadoSolicitud.Aprobada or EstadoSolicitud.EntregadaParcial
        && _solicitud.Detalles.Any(d => d.CantidadAprobada > d.CantidadEntregada))
    {
        <div class="info-banner no-print">
            <Icon Name="info" Size="18" />
            <p>Quedan líneas por @(_solicitud.Tipo == TipoSolicitud.Entrada ? "recibir" : "entregar") — se registra desde Movimientos, eligiendo esta solicitud.</p>
            <button type="button" class="btn btn-secondary btn-sm" @onclick="IrAMovimientos">Ir a Movimientos</button>
        </div>
    }

    @if (_solicitud.Estado == EstadoSolicitud.Pendiente && (AuthState.HasPermission(Permisos.SolicitudesAprobar) || AuthState.HasPermission(Permisos.SolicitudesRechazar)))
    {
        <div class="no-print" style="display:flex;gap:12px;align-items:center;margin-top:20px;flex-wrap:wrap">
            @if (AuthState.HasPermission(Permisos.SolicitudesAprobar))
            {
                <button type="button" class="btn btn-primary" disabled="@_guardando" @onclick="AprobarAsync">Aprobar solicitud</button>
            }
            @if (AuthState.HasPermission(Permisos.SolicitudesRechazar))
            {
                <input class="input" style="max-width:300px" placeholder="Motivo de rechazo" @bind="_motivoRechazo" />
                <button type="button" class="btn btn-ghost" style="color:#b42318" disabled="@_guardando" @onclick="RechazarAsync">Rechazar</button>
            }
        </div>
    }

    <div class="hr no-print" style="margin-top:36px"></div>
    <h3 class="no-print">Formulario imprimible</h3>
    <div class="printable printable-form">
        <div class="printable-form-fecha">
            <span class="pf-label">Fecha:</span>
            <span class="pf-fecha-value">@_solicitud.FechaSolicitud.ToLocalTime().ToString("d/M/yyyy")</span>
        </div>
        <p class="printable-form-title">FORMULARIO<br />SOLICITUD MATERIAL PUBLICITARIO</p>

        <div class="printable-form-checks">
            <span>Movimiento :</span>
            <span>@(_solicitud.Tipo == TipoSolicitud.Entrada ? "☑" : "☐") ENTRADA</span>
            <span>@(_solicitud.Tipo == TipoSolicitud.Salida ? "☑" : "☐") SALIDA</span>
        </div>
        <div class="printable-form-row">
            <div class="pf-label">Solicitante:</div>
            <div class="pf-value">@_solicitud.SolicitadoPor</div>
        </div>
        <div class="printable-form-row">
            <div class="pf-label">Autorizado por:</div>
            <div class="pf-value">@(_solicitud.AprobadoPor ?? "")</div>
        </div>
        <div class="printable-form-row">
            <div class="pf-label">Categoria</div>
            <div class="pf-value">@_solicitud.AreaNombre</div>
        </div>

        <div class="printable-form-table-wrap">
            <table class="printable-form-table">
                <thead>
                    <tr><th>CODIGO</th><th>DESCRIPCION</th><th>CANTIDAD</th><th>UME</th><th>Costo unit.</th><th>LOTE</th></tr>
                </thead>
                <tbody>
                    @foreach (var d in _solicitud.Detalles)
                    {
                        <tr>
                            <td>@d.ProductoCodigo</td>
                            <td>@d.ProductoNombre</td>
                            <td>@d.CantidadSolicitada.ToString("N0")</td>
                            <td>@d.UnidadMedida</td>
                            <td>@(d.CostoUnitario is null ? "" : d.CostoUnitario.Value.ToString("N2"))</td>
                            <td></td>
                        </tr>
                    }
                    @for (var i = _solicitud.Detalles.Count; i < FilasMinimasTabla; i++)
                    {
                        <tr><td></td><td></td><td></td><td></td><td></td><td></td></tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="printable-form-motivo">
            <span class="pf-label">Motivo / Observaciones:</span>
            <span>@(_solicitud.Estado == EstadoSolicitud.Rechazada ? _solicitud.MotivoRechazo : "")</span>
        </div>

        <div class="printable-form-firmas">
            <div>NOMBRE Y FIRMA<br />PROVEEDOR/SOLICITANTE</div>
            <div>FIRMA ALMACÉN</div>
        </div>
    </div>
    <button type="button" class="btn btn-primary no-print" style="margin-top:16px" @onclick="Imprimir">
        <Icon Name="print" Size="14" />
        Imprimir formulario
    </button>
}

@code {
    [Parameter] public int Id { get; set; }

    private SolicitudDto? _solicitud;
    private readonly Dictionary<int, int> _cantidadAprobada = new();
    private string? _motivoRechazo;
    private bool _guardando;
    private string? _error;
    private string? _ok;

    protected override async Task OnInitializedAsync() => await CargarAsync();

    private async Task CargarAsync()
    {
        try
        {
            _solicitud = await SolicitudApi.ObtenerPorIdAsync(Id);
            if (_solicitud is not null)
                foreach (var d in _solicitud.Detalles)
                {
                    // Se pre-carga acá, no donde se usa — @bind lee la clave del diccionario
                    // directo (no GetValueOrDefault), y si no está todavía en ese momento el
                    // @bind revienta con KeyNotFoundException y tira abajo el circuito entero.
                    _cantidadAprobada.TryAdd(d.Id, d.CantidadSolicitada);
                }
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
    }

    private async Task AprobarAsync()
    {
        if (_guardando || _solicitud is null) return;
        _guardando = true;
        _error = null;

        try
        {
            var lineas = _solicitud.Detalles
                .Select(d => new AprobarSolicitudDetalleDto(d.Id, _cantidadAprobada.GetValueOrDefault(d.Id)))
                .Where(l => l.CantidadAprobada > 0)
                .ToList();

            _solicitud = await SolicitudApi.AprobarAsync(Id, new AprobarSolicitudDto(lineas));
            _ok = "Solicitud aprobada.";
        }
        catch (ApiException ex) { _error = ex.Message; }
        finally { _guardando = false; }
    }

    private async Task RechazarAsync()
    {
        if (_guardando) return;
        if (string.IsNullOrWhiteSpace(_motivoRechazo)) { _error = "Indicá el motivo de rechazo."; return; }

        _guardando = true;
        _error = null;

        try
        {
            _solicitud = await SolicitudApi.RechazarAsync(Id, new RechazarSolicitudDto(_motivoRechazo));
            _ok = "Solicitud rechazada.";
        }
        catch (ApiException ex) { _error = ex.Message; }
        finally { _guardando = false; }
    }

    // El registro real de la entrega/recepción se mueve a Movimientos (Registrar
    // entrada/salida → SolicitudEntregaPanel), que ya elige la solicitud y arma el mismo
    // Movimiento — tenerlo acá también era el mismo flujo duplicado en dos pantallas.
    private void IrAMovimientos() => Nav.NavigateTo("/movimientos");

    private const int FilasMinimasTabla = 32;

    private async Task Imprimir() => await JS.InvokeVoidAsync("print");

    private static (string Clase, string Icono, string Texto) EstadoBadge(EstadoSolicitud e) => e switch
    {
        EstadoSolicitud.Pendiente => ("tag-warn", "clock", "Pendiente"),
        EstadoSolicitud.Aprobada => ("tag-success", "check-circle", "Aprobada"),
        EstadoSolicitud.EntregadaParcial => ("tag-orange", "package", "Entrega parcial"),
        EstadoSolicitud.Entregada => ("tag-accent", "check-circle", "Entregada"),
        EstadoSolicitud.Rechazada => ("tag-danger", "x-circle", "Rechazada"),
        _ => ("tag-neutral", "info", e.ToString()),
    };

    private static string Iniciales(string nombre)
    {
        var partes = nombre.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return partes.Length == 0 ? "?" : string.Concat(partes.Take(2).Select(p => char.ToUpperInvariant(p[0])));
    }
}
