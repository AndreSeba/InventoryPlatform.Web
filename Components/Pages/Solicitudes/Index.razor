@page "/solicitudes"
@rendermode InteractiveServer
@inject SolicitudApiClient SolicitudApi
@inject AreaApiClient AreaApi
@inject ProductoApiClient ProductoApi
@inject NavigationManager Nav

<PageTitle>Solicitudes</PageTitle>

<div class="page-head">
    <div>
        <h1>Solicitudes</h1>
        <p class="text-muted" style="margin-top:-6px">Pedidos de material promocional por área, con aprobación y entrega.</p>
    </div>
    <button type="button" class="btn btn-primary" @onclick="AbrirNueva">+ Nueva solicitud</button>
</div>

@if (_error is not null)
{
    <p class="dialog-error">@_error</p>
}

@if (_solicitudes is null)
{
    <p>Cargando…</p>
}
else
{
    <div class="filter-row">
        <div class="chip-row">
            <button type="button" class="btn @(_filtroEstado == "" ? "btn-primary" : "btn-secondary")" @onclick='() => SetFiltro("")'>Todas</button>
            <button type="button" class="btn @(_filtroEstado == "Pendiente" ? "btn-primary" : "btn-secondary")" @onclick='() => SetFiltro("Pendiente")'>Pendiente</button>
            <button type="button" class="btn @(_filtroEstado == "Aprobada" ? "btn-primary" : "btn-secondary")" @onclick='() => SetFiltro("Aprobada")'>Aprobada</button>
            <button type="button" class="btn @(_filtroEstado == "EntregadaParcial" ? "btn-primary" : "btn-secondary")" @onclick='() => SetFiltro("EntregadaParcial")'>Entregada parcial</button>
            <button type="button" class="btn @(_filtroEstado == "Entregada" ? "btn-primary" : "btn-secondary")" @onclick='() => SetFiltro("Entregada")'>Entregada</button>
            <button type="button" class="btn @(_filtroEstado == "Rechazada" ? "btn-primary" : "btn-secondary")" @onclick='() => SetFiltro("Rechazada")'>Rechazada</button>
        </div>
    </div>

    @if (_solicitudes.Count == 0)
    {
        <p class="text-muted" style="margin-top:20px">No hay solicitudes con ese filtro.</p>
    }
    else
    {
        <div class="table-wrap">
            <table class="table">
                <thead><tr><th>N.º</th><th>Área</th><th>Estado</th><th>Solicitado por</th><th>Fecha</th><th></th></tr></thead>
                <tbody>
                    @foreach (var s in _solicitudes)
                    {
                        <tr>
                            <td>@s.NumeroSolicitud</td>
                            <td>@s.AreaNombre</td>
                            <td><span class="@EstadoTagClase(s.Estado)">@s.Estado</span></td>
                            <td class="text-muted">@s.SolicitadoPor</td>
                            <td class="text-muted">@s.FechaSolicitud.ToLocalTime().ToString("dd/MM/yyyy")</td>
                            <td><button type="button" class="btn btn-ghost btn-sm" @onclick="() => VerSolicitud(s.Id)">Ver</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

<Dialog Visible="_dialogOpen" Title="Nueva solicitud">
    <Body>
        <div class="field">
            <label>Área solicitante</label>
            <select class="input" @bind="_areaId">
                <option value="0">-- Seleccionar --</option>
                @foreach (var a in _areas ?? [])
                {
                    <option value="@a.Id">@a.NombreArea</option>
                }
            </select>
        </div>

        <div class="hr"></div>
        <label style="font-size:12px;color:var(--color-text)">Líneas</label>
        @foreach (var linea in _lineas)
        {
            <div style="display:flex;gap:10px;align-items:center">
                <select class="input" @bind="linea.ProductoId">
                    <option value="0">-- Producto --</option>
                    @foreach (var p in _productos ?? [])
                    {
                        <option value="@p.Id">@p.CodigoProducto — @p.Nombre</option>
                    }
                </select>
                <input class="input" style="max-width:110px" type="number" min="0" step="0.01" placeholder="Cant." @bind="linea.Cantidad" />
                <button type="button" class="btn btn-ghost btn-icon" title="Quitar" @onclick="() => _lineas.Remove(linea)"><Icon Name="x" Size="16" /></button>
            </div>
        }
        <button type="button" class="btn btn-secondary btn-sm" style="align-self:flex-start" @onclick="() => _lineas.Add(new LineaForm())">+ Agregar línea</button>

        @if (_dialogError is not null)
        {
            <p class="dialog-error">@_dialogError</p>
        }
    </Body>
    <Actions>
        <button type="button" class="btn btn-ghost" @onclick="() => _dialogOpen = false">Cancelar</button>
        <button type="button" class="btn btn-primary" disabled="@_guardando" @onclick="Enviar">@(_guardando ? "Enviando…" : "Enviar solicitud")</button>
    </Actions>
</Dialog>

@code {
    private List<SolicitudDto>? _solicitudes;
    private List<AreaDto>? _areas;
    private List<ProductoDto>? _productos;
    private string _filtroEstado = "";
    private string? _error;

    private bool _dialogOpen;
    private bool _guardando;
    private string? _dialogError;
    private int _areaId;
    private List<LineaForm> _lineas = [new()];

    protected override async Task OnInitializedAsync() => await CargarAsync();

    private async Task CargarAsync()
    {
        try
        {
            _solicitudes = await SolicitudApi.ListarAsync(string.IsNullOrEmpty(_filtroEstado) ? null : _filtroEstado);
            _areas = await AreaApi.ListarAsync();
            _productos = await ProductoApi.ListarAsync();
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
            _solicitudes = []; _areas = []; _productos = [];
        }
    }

    private void VerSolicitud(int id) => Nav.NavigateTo($"/solicitudes/{id}");

    private async Task SetFiltro(string estado)
    {
        _filtroEstado = estado;
        try { _solicitudes = await SolicitudApi.ListarAsync(string.IsNullOrEmpty(estado) ? null : estado); }
        catch (ApiException ex) { _error = ex.Message; }
    }

    private void AbrirNueva()
    {
        _areaId = 0;
        _lineas = [new()];
        _dialogError = null;
        _dialogOpen = true;
    }

    private async Task Enviar()
    {
        if (_guardando) return;
        if (_areaId <= 0) { _dialogError = "Seleccioná el área solicitante."; return; }

        var lineasValidas = _lineas.Where(l => l.ProductoId > 0 && l.Cantidad > 0).ToList();
        if (lineasValidas.Count == 0) { _dialogError = "Agregá al menos una línea con producto y cantidad."; return; }

        _guardando = true;
        _dialogError = null;

        try
        {
            var detalles = lineasValidas.Select(l => new CrearSolicitudDetalleDto(l.ProductoId, l.Cantidad)).ToList();
            var creada = await SolicitudApi.CrearAsync(new CrearSolicitudDto(_areaId, detalles));
            _dialogOpen = false;
            Nav.NavigateTo($"/solicitudes/{creada.Id}");
        }
        catch (ApiException ex)
        {
            _dialogError = ex.Message;
        }
        finally
        {
            _guardando = false;
        }
    }

    private static string EstadoTagClase(EstadoSolicitud e) => e switch
    {
        EstadoSolicitud.Pendiente => "tag tag-warn",
        EstadoSolicitud.Aprobada or EstadoSolicitud.EntregadaParcial => "tag tag-outline",
        EstadoSolicitud.Entregada => "tag tag-accent",
        EstadoSolicitud.Rechazada => "tag tag-neutral",
        _ => "tag tag-neutral",
    };

    private class LineaForm
    {
        public int ProductoId { get; set; }
        public decimal Cantidad { get; set; }
    }
}
