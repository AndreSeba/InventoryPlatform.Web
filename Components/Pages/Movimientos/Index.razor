@page "/movimientos"
@inject ProductoApiClient ProductoApi
@inject UbicacionApiClient UbicacionApi
@inject CategoriaApiClient CategoriaApi
@inject MovimientoApiClient MovimientoApi
@inject DevolucionApiClient DevolucionApi
@inject AuthState AuthState
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>Movimientos</PageTitle>

<div class="page-head">
    <div>
        <h1>Movimientos</h1>
        <p class="text-muted" style="margin-top:-6px">Registre entradas, salidas y ajustes de material promocional.</p>
    </div>
    <div style="display:flex;gap:12px;flex-wrap:wrap">
        @if (AuthState.HasPermission(Permisos.MovimientosEntrada))
        {
            <button type="button" class="btn btn-secondary" @onclick="AbrirEntrada">Registrar entrada</button>
        }
        @if (AuthState.HasPermission(Permisos.MovimientosAjuste))
        {
            <button type="button" class="btn btn-secondary" @onclick="AbrirAjuste">Registrar ajuste</button>
        }
        @if (AuthState.HasPermission(Permisos.MovimientosSalida))
        {
            <button type="button" class="btn btn-primary" @onclick="AbrirSalida">Registrar salida</button>
        }
    </div>
</div>

@if (_error is not null)
{
    <p class="dialog-error">@_error</p>
}
@if (_ok is not null)
{
    <p style="color:var(--color-accent-700);font-size:13px">@_ok</p>
}

@if (_movimientos is null || _productos is null || _ubicaciones is null || _categorias is null)
{
    <p>Cargando…</p>
}
else
{
    @* Tres secciones en pestañas (antes iban una debajo de otra y había que bajar para llegar a los préstamos).
       Los contadores y el aviso rojo de mora dejan ver lo urgente sin cambiar de pestaña. *@
    <div class="tabs" role="tablist">
        <button type="button" role="tab" class="tab @(_tab == TabLibro ? "on" : "")" aria-selected="@(_tab == TabLibro)" @onclick="() => _tab = TabLibro">
            Movimientos <span class="cnt">@_movimientos.Count.ToString("N0")</span>
        </button>
        @if (AuthState.HasPermission(Permisos.MovimientosDevolucion))
        {
            <button type="button" role="tab" class="tab @(_tab == TabAvisos ? "on" : "")" aria-selected="@(_tab == TabAvisos)" @onclick="() => _tab = TabAvisos">
                Devoluciones por recibir <span class="cnt @(CantidadAvisos > 0 ? "warn" : "")">@CantidadAvisos</span>
            </button>
        }
        <button type="button" role="tab" class="tab @(_tab == TabPrestamos ? "on" : "")" aria-selected="@(_tab == TabPrestamos)" @onclick="() => _tab = TabPrestamos">
            Préstamos pendientes <span class="cnt">@(_prestamos?.Count ?? 0)</span>
            @if (PrestamosEnMora > 0)
            {
                <span class="cnt danger">@PrestamosEnMora en mora</span>
            }
        </button>
    </div>

    @if (_tab == TabLibro)
    {
    <div class="filter-row">
        <select class="input" style="max-width:220px" @bind="_filtroCategoria" @bind:after="ReiniciarPaginas">
            <option value="">Todas las categorías</option>
            @foreach (var c in _categorias)
            {
                <option value="@c.CodigoCategoria">@c.CodigoCategoria</option>
            }
        </select>
        <select class="input" style="max-width:180px" @bind="_filtroTipo" @bind:after="ReiniciarPaginas">
            <option value="">Todos los tipos</option>
            <option value="Entrada">Entrada</option>
            <option value="Salida">Salida</option>
            <option value="AjustePositivo">Ajuste +</option>
            <option value="AjusteNegativo">Ajuste -</option>
        </select>
        <input class="input" style="max-width:160px" type="date" title="Desde" @bind="_filtroDesde" @bind:after="ReiniciarPaginas" />
        <input class="input" style="max-width:160px" type="date" title="Hasta" @bind="_filtroHasta" @bind:after="ReiniciarPaginas" />
        <button type="button" class="btn btn-ghost" disabled="@_exportando" @onclick="ExportarExcelAsync">@(_exportando ? "Generando…" : "Exportar a Excel")</button>
    </div>
    @if (_errorExportar is not null)
    {
        <p class="dialog-error">@_errorExportar</p>
    }

    @* Libro de movimientos: UNA fila por movimiento de stock (entradas, salidas, ajustes y
       devoluciones, vengan o no de una solicitud). La solicitud de origen es solo una referencia
       con enlace — la lista de solicitudes vive en su propio módulo. *@
    @if (Filtrados().Count == 0)
    {
        <p class="text-muted" style="margin-top:20px">Sin movimientos para este filtro.</p>
    }
    else
    {
        <div class="table-wrap">
            <table class="table">
                <thead><tr><th>Fecha</th><th>N.º mov.</th><th>Producto</th><th>Tipo</th><th class="num">Cantidad</th><th>Ubicación</th><th>Solicitud</th><th>Registrado por</th><th>Motivo</th></tr></thead>
                <tbody>
                    @foreach (var m in MovimientosPaginados())
                    {
                        <tr>
                            <td class="text-muted" style="white-space:nowrap">
                                @m.FechaMovimiento.ToLocalTime().ToString("dd/MM/yyyy")
                                <div style="font-size:12px">@m.FechaMovimiento.ToLocalTime().ToString("HH:mm")</div>
                            </td>
                            <td class="sol-num">@m.NumeroMovimiento</td>
                            <td class="celda-truncada celda-corta" title="@m.ProductoNombre">
                                @m.ProductoNombre
                                <div class="text-muted" style="font-size:12px">@CategoriaDe(m.ProductoId)</div>
                            </td>
                            <td><TipoMovimientoTag Tipo="m.TipoMovimiento" /></td>
                            <td class="num">@m.Cantidad.ToString("N0")</td>
                            <td class="text-muted">
                                @UbicacionORetorna(m)
                                @if (!string.IsNullOrWhiteSpace(m.AlmacenNombre))
                                {
                                    <div style="font-size:12px">@m.AlmacenNombre</div>
                                }
                            </td>
                            <td>
                                @if (m.SolicitudId is not null)
                                {
                                    <a class="sol-num" href="/solicitudes/@m.SolicitudId" title="Abrir la solicitud">@m.NumeroSolicitud</a>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td><AvatarNombre Nombre="@m.RegistradoPor" /></td>
                            <td class="text-muted celda-truncada celda-corta" title="@m.Motivo">@(string.IsNullOrWhiteSpace(m.Motivo) ? "—" : m.Motivo)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <Pager TotalItems="Filtrados().Count" PaginaActual="_pagina" PaginaActualChanged="p => _pagina = p" TamanoPagina="TamanoPagina" />
    }
    }

    @if (_tab == TabAvisos && AuthState.HasPermission(Permisos.MovimientosDevolucion))
    {
        <h3>Devoluciones avisadas — por recibir</h3>
        <p class="text-muted" style="margin-top:-6px">Quien pidió el material avisó que lo devuelve. Cuando llegue, registrá la entrada contra el aviso.</p>

        @if (_avisos is null)
        {
            <p>Cargando…</p>
        }
        else if (_avisos.Count == 0)
        {
            <p class="text-muted">No hay devoluciones avisadas por recibir.</p>
        }
        else
        {
            <div class="table-wrap">
                <table class="table">
                    <thead><tr><th>Aviso</th><th>Producto</th><th>Cantidad avisada</th><th>Avisó</th><th>Préstamo</th><th>Fecha</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var a in _avisos)
                        {
                            <tr>
                                <td class="sol-num">@a.Codigo</td>
                                <td>@a.ProductoNombre</td>
                                <td>@a.Cantidad.ToString("N0")</td>
                                <td><AvatarNombre Nombre="@a.AvisadoPor" /></td>
                                <td class="text-muted">@a.NumeroMovimientoOrigen @(a.NumeroSolicitud is null ? "" : $"· {a.NumeroSolicitud}")</td>
                                <td class="text-muted">@a.FechaAviso.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                <td><button type="button" class="btn btn-primary btn-sm" @onclick="() => AbrirRecepcion(a)">Recibir</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }

    @if (_tab == TabPrestamos)
    {
    <h3>Préstamos pendientes de devolución</h3>
    <p class="text-muted" style="margin-top:-6px">Material que salió con "Retorna" y todavía no volvió por completo, y quién lo tiene.</p>

    @if (_prestamos is null)
    {
        <p>Cargando…</p>
    }
    else if (_prestamos.Count == 0)
    {
        <p class="text-muted">No hay préstamos pendientes.</p>
    }
    else
    {
        <div class="table-wrap">
            <table class="table">
                <thead><tr><th>N.º movimiento</th><th>Producto</th><th>Lo tiene</th><th>Pendiente</th><th>Destino</th><th>Retorno esperado</th><th>Aviso</th><th></th></tr></thead>
                <tbody>
                    @foreach (var m in PrestamosPaginados())
                    {
                        <tr>
                            <td>@m.NumeroMovimiento</td>
                            <td>@m.ProductoNombre</td>
                            <td>
                                @if (m.SolicitadoPor is null)
                                {
                                    <span class="text-muted">Sin solicitud</span>
                                }
                                else
                                {
                                    <AvatarNombre Nombre="@m.SolicitadoPor" />
                                    <div class="text-muted" style="font-size:12px">@m.NumeroSolicitud</div>
                                }
                            </td>
                            <td>@m.Pendiente.ToString("N0") <span class="text-muted">de @m.Prestado.ToString("N0")</span></td>
                            <td class="text-muted">@m.UbicacionExterna</td>
                            <td class="text-muted">
                                @(m.FechaRetornoEsperada?.ToString("dd/MM/yyyy") ?? "—")
                                @if (m.DiasMora > 0)
                                {
                                    <span class="tag tag-danger tag-con-icono"><Icon Name="alert" Size="13" />@m.DiasMora día(s) de mora</span>
                                }
                            </td>
                            <td>
                                @if (m.EnAviso > 0)
                                {
                                    <span class="tag tag-warn tag-con-icono"><Icon Name="clock" Size="13" />@m.EnAviso avisadas</span>
                                }
                                else if (m.SolicitadoPor is not null)
                                {
                                    <span class="text-muted">Sin aviso</span>
                                }
                            </td>
                            <td>
                                @* Un préstamo sin solicitud (de antes de los controles) no tiene a quién avisar: se devuelve directo. *@
                                @if (m.SolicitadoPor is null && AuthState.HasPermission(Permisos.MovimientosDevolucion))
                                {
                                    <button type="button" class="btn btn-ghost btn-sm" @onclick="() => AbrirDevolucionDirecta(m)">Registrar devolución</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <Pager TotalItems="_prestamos.Count" PaginaActual="_paginaPrestamos" PaginaActualChanged="p => _paginaPrestamos = p" TamanoPagina="TamanoPagina" />
    }
    }
}

<!-- ===== Diálogo: Entrada ===== -->
<Dialog OnClose="CerrarDialogo" Visible="@(_dialog == "entrada")" Title="Registrar entrada" Ancho="true">
    <Body>
        <SolicitudEntregaPanel Tipo="TipoSolicitud.Entrada" UbicacionesTodas="_ubicaciones" OnRegistrado="CargarAsync" />
    </Body>
    <Actions>
        <button type="button" class="btn btn-ghost" @onclick="CerrarDialogo">Cerrar</button>
    </Actions>
</Dialog>

<!-- ===== Diálogo: Salida ===== -->
<Dialog OnClose="CerrarDialogo" Visible="@(_dialog == "salida")" Title="Registrar salida" Ancho="true">
    <Body>
        <SolicitudEntregaPanel Tipo="TipoSolicitud.Salida" OnRegistrado="CargarAsync" />
    </Body>
    <Actions>
        <button type="button" class="btn btn-ghost" @onclick="CerrarDialogo">Cerrar</button>
    </Actions>
</Dialog>

<!-- ===== Diálogo: Ajuste ===== -->
<Dialog OnClose="CerrarDialogo" Visible="@(_dialog == "ajuste")" Title="Registrar ajuste">
    <Body>
        <div class="field">
            <label>Producto</label>
            <ComboBuscable TItem="ProductoDto" Items="_productos" SelectedId="_movProductoId" SelectedIdChanged="OnProductoCambiadoAsync" GetId="ObtenerIdProducto" GetLabel="EtiquetaProducto">
                <ItemTemplate Context="p">
                    <span class="combo-prod">
                        @if (string.IsNullOrWhiteSpace(p.ImagenUrl))
                        {
                            <span class="combo-prod-img"><Icon Name="package" Size="18" /></span>
                        }
                        else
                        {
                            @* loading=lazy: la lista trae todo el catálogo; solo se bajan las fotos que se ven. *@
                            <img class="combo-prod-img" loading="lazy" decoding="async" alt="" src="@($"{ProductoApi.ApiBaseUrl}{p.ImagenUrl}")" />
                        }
                        <span class="combo-prod-text"><strong>@p.CodigoProducto</strong> - @p.Nombre</span>
                    </span>
                </ItemTemplate>
            </ComboBuscable>
        </div>
        <div class="field">
            <label>Sentido del ajuste</label>
            <div class="seg" role="radiogroup">
                <label class="seg-opt @(_movAjustePositivo ? "active" : "")" @onclick="() => CambiarSentidoAjusteAsync(true)">Positivo (+)</label>
                <label class="seg-opt @(!_movAjustePositivo ? "active" : "")" @onclick="() => CambiarSentidoAjusteAsync(false)">Negativo (-)</label>
            </div>
        </div>
        <div class="field">
            <label>Ubicación</label>
            @if (_movAjustePositivo)
            {
                <select class="input" @bind="_movUbicacionId">
                    <option value="0">-- Seleccionar --</option>
                    @foreach (var u in _ubicaciones ?? [])
                    {
                        <option value="@u.Id">@u.CodigoUbicacion — @u.AlmacenNombre</option>
                    }
                </select>
            }
            else if (_movProductoId <= 0)
            {
                <select class="input" disabled><option>Elegí primero un producto</option></select>
            }
            else if (_cargandoUbicaciones)
            {
                <select class="input" disabled><option>Cargando…</option></select>
            }
            else if ((_ubicacionesConStock?.Count ?? 0) == 0)
            {
                <select class="input" disabled><option>Este producto no tiene stock en ninguna ubicación</option></select>
            }
            else
            {
                <select class="input" @bind="_movUbicacionId">
                    <option value="0">-- Seleccionar --</option>
                    @foreach (var u in _ubicacionesConStock!)
                    {
                        <option value="@u.UbicacionId">@u.UbicacionCodigo — @u.AlmacenNombre (@u.Existencia.ToString("N0"))</option>
                    }
                </select>
            }
        </div>
        <div class="field"><label>Cantidad</label><CampoCantidad @bind-Value="_movCantidad" /></div>
        <div class="field"><label>Motivo (obligatorio)</label><textarea class="input" rows="3" @bind="_movMotivo"></textarea></div>
        @if (_dialogError is not null)
        {
            <p class="dialog-error">@_dialogError</p>
        }
    </Body>
    <Actions>
        <button type="button" class="btn btn-ghost" @onclick="CerrarDialogo">Cancelar</button>
        <button type="button" class="btn btn-primary" disabled="@(_guardando || SinStockParaFiltro)" @onclick="ConfirmarAjuste">Confirmar ajuste</button>
    </Actions>
</Dialog>

<!-- ===== Diálogo: Devolución ===== -->
<Dialog OnClose="CerrarDialogo" Visible="@(_dialog == "devolucion")" Title="@(_recibiendoAviso is null ? "Registrar devolución" : "Recibir devolución")">
    <Body>
        @if (_recibiendoAviso is not null)
        {
            <p style="margin:0">
                <strong>@_recibiendoAviso.ProductoNombre</strong> — @_recibiendoAviso.NumeroMovimientoOrigen
            </p>
            <p class="text-muted" style="margin:2px 0 0">@_recibiendoAviso.AvisadoPor avisó que devuelve @_recibiendoAviso.Cantidad.ToString("N0") unidad(es) (@_recibiendoAviso.Codigo). Si llegó menos, registrá lo que realmente recibís: el resto sigue como préstamo pendiente.</p>
        }
        else if (_devolviendoPrestamo is not null)
        {
            <p class="text-muted" style="margin:0">@_devolviendoPrestamo.NumeroMovimiento — @_devolviendoPrestamo.ProductoNombre (pendientes @_devolviendoPrestamo.Pendiente.ToString("N0") de @_devolviendoPrestamo.Prestado.ToString("N0"))</p>
        }
        <div class="field">
            <label>Ubicación de retorno</label>
            <select class="input" @bind="_movUbicacionId">
                <option value="0">-- Seleccionar --</option>
                @foreach (var u in _ubicaciones ?? [])
                {
                    <option value="@u.Id">@u.CodigoUbicacion — @u.AlmacenNombre</option>
                }
            </select>
        </div>
        <div class="field"><label>@(_recibiendoAviso is null ? "Cantidad a devolver" : "Cantidad recibida")</label><CampoCantidad @bind-Value="_movCantidad" Min="1" Max="MaximoDevolucion" /></div>
        @if (_dialogError is not null)
        {
            <p class="dialog-error">@_dialogError</p>
        }
    </Body>
    <Actions>
        <button type="button" class="btn btn-ghost" @onclick="CerrarDialogo">Cancelar</button>
        <button type="button" class="btn btn-primary" disabled="@_guardando" @onclick="ConfirmarDevolucion">@(_recibiendoAviso is null ? "Confirmar devolución" : "Confirmar recepción")</button>
    </Actions>
</Dialog>

@code {
    private List<MovimientoDto>? _movimientos;
    private List<PrestamoDto>? _prestamos;
    private List<AvisoDevolucionDto>? _avisos;

    private const string TabLibro = "libro";
    private const string TabAvisos = "avisos";
    private const string TabPrestamos = "prestamos";
    private string _tab = TabLibro;

    private int CantidadAvisos => _avisos?.Count ?? 0;
    private int PrestamosEnMora => _prestamos?.Count(p => p.DiasMora > 0) ?? 0;
    private List<ProductoDto>? _productos;
    private List<UbicacionDto>? _ubicaciones;
    private List<CategoriaDto>? _categorias;
    private string _filtroCategoria = "";
    private string _filtroTipo = "";
    private DateTime? _filtroDesde;
    private DateTime? _filtroHasta;
    private string? _error;
    private string? _ok;
    private bool _exportando;
    private string? _errorExportar;

    private const int TamanoPagina = 10;
    private int _pagina = 1;
    private int _paginaPrestamos = 1;

    private void ReiniciarPaginas() => _pagina = 1;

    private List<MovimientoDto> MovimientosPaginados() => Filtrados()
        .Skip((_pagina - 1) * TamanoPagina)
        .Take(TamanoPagina)
        .ToList();

    private List<PrestamoDto> PrestamosPaginados() => (_prestamos ?? [])
        .Skip((_paginaPrestamos - 1) * TamanoPagina)
        .Take(TamanoPagina)
        .ToList();

    private string? _dialog; // "entrada" | "salida" | "ajuste" | "devolucion" | null
    private bool _guardando;
    private string? _dialogError;

    private int _movProductoId;
    private int _movUbicacionId;
    private int _movCantidad;
    private string? _movMotivo;
    private bool _movRetorna;
    private string? _movUbicacionExterna;
    private DateTime? _movFechaRetorno;
    private bool _movAjustePositivo = true;
    // Tope de la devolución: contra un aviso, lo avisado; directa, lo que sigue prestado. Menos se puede, más no.
    private int? MaximoDevolucion => _recibiendoAviso?.Cantidad ?? _devolviendoPrestamo?.Pendiente;

    private PrestamoDto? _devolviendoPrestamo;      // devolución directa (préstamo sin solicitud)
    private AvisoDevolucionDto? _recibiendoAviso;      // recepción contra un aviso del solicitante

    // Salida y Ajuste negativo solo dejan elegir ubicaciones donde el producto realmente
    // tiene stock (Entrada/Ajuste positivo/Devolución siguen con la lista completa, porque
    // ahí es donde un producto se guarda por primera vez en un lugar nuevo).
    private List<UbicacionConExistenciaDto>? _ubicacionesConStock;
    private bool _cargandoUbicaciones;

    private bool RequiereFiltroUbicacion => _dialog == "ajuste" && !_movAjustePositivo;
    private bool SinStockParaFiltro => RequiereFiltroUbicacion && _movProductoId > 0 && !_cargandoUbicaciones && (_ubicacionesConStock?.Count ?? 0) == 0;

    protected override async Task OnInitializedAsync() => await CargarAsync();

    private async Task CargarAsync()
    {
        try
        {
            // En paralelo: son cinco pedidos independientes, y uno tras otro la pantalla
            // tardaba la SUMA de las cinco latencias en vez de la del más lento.
            var movimientos = MovimientoApi.ListarAsync();
            var prestamos = DevolucionApi.ListarPrestamosAsync();
            var productos = ProductoApi.ListarAsync();
            var ubicaciones = UbicacionApi.ListarAsync();
            var categorias = CategoriaApi.ListarAsync();
            // Los avisos por recibir solo los ve (y los pide) quien registra devoluciones.
            var avisos = AuthState.HasPermission(Permisos.MovimientosDevolucion)
                ? DevolucionApi.ListarAvisosAsync(EstadoAvisoDevolucion.Pendiente)
                : Task.FromResult(new List<AvisoDevolucionDto>());
            await Task.WhenAll(movimientos, prestamos, productos, ubicaciones, categorias, avisos);

            _movimientos = movimientos.Result;
            _prestamos = prestamos.Result;
            _avisos = avisos.Result;
            _productos = productos.Result;
            _ubicaciones = ubicaciones.Result;
            _categorias = categorias.Result;
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
            _movimientos = []; _prestamos = []; _avisos = []; _productos = []; _ubicaciones = []; _categorias = [];
        }
    }

    private string CategoriaDe(int productoId) => _productos?.FirstOrDefault(p => p.Id == productoId)?.CategoriaNombre ?? "—";

    private static int ObtenerIdProducto(ProductoDto p) => p.Id;
    private static string EtiquetaProducto(ProductoDto p) => $"{p.CodigoProducto} — {p.Nombre}";

    private async Task OnProductoCambiadoAsync(int id)
    {
        _movProductoId = id;
        await ActualizarUbicacionesDisponiblesAsync();
    }

    private List<MovimientoDto> Filtrados() => (_movimientos ?? [])
        .Where(m => string.IsNullOrEmpty(_filtroCategoria) || CategoriaDe(m.ProductoId) == _filtroCategoria)
        .Where(m => string.IsNullOrEmpty(_filtroTipo) || m.TipoMovimiento.ToString() == _filtroTipo)
        .Where(m => _filtroDesde is null || m.FechaMovimiento.ToLocalTime().Date >= _filtroDesde.Value.Date)
        .Where(m => _filtroHasta is null || m.FechaMovimiento.ToLocalTime().Date <= _filtroHasta.Value.Date)
        .OrderByDescending(m => m.FechaMovimiento)
        .ToList();

    private async Task ExportarExcelAsync()
    {
        if (_exportando) return;
        _exportando = true;
        _errorExportar = null;

        try
        {
            TipoMovimiento? tipo = Enum.TryParse<TipoMovimiento>(_filtroTipo, out var t) ? t : null;
            int? categoriaId = string.IsNullOrEmpty(_filtroCategoria)
                ? null
                : _categorias?.FirstOrDefault(c => c.CodigoCategoria == _filtroCategoria)?.Id;

            var (contenido, nombreArchivo) = await MovimientoApi.GenerarExcelAsync(new GenerarMovimientosExcelDto(tipo, categoriaId));
            await JS.InvokeVoidAsync("descargarArchivo", nombreArchivo,
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", Convert.ToBase64String(contenido));
        }
        catch (ApiException ex) { _errorExportar = ex.Message; }
        finally { _exportando = false; }
    }

    private void LimpiarCampos()
    {
        _movProductoId = 0; _movUbicacionId = 0; _movCantidad = 0; _movMotivo = null;
        _movRetorna = false; _movUbicacionExterna = null; _movFechaRetorno = null; _movAjustePositivo = true;
        _dialogError = null; _ubicacionesConStock = null; _cargandoUbicaciones = false;
    }

    private async Task CambiarSentidoAjusteAsync(bool positivo)
    {
        _movAjustePositivo = positivo;
        await ActualizarUbicacionesDisponiblesAsync();
    }

    private async Task ActualizarUbicacionesDisponiblesAsync()
    {
        _movUbicacionId = 0;
        if (!RequiereFiltroUbicacion || _movProductoId <= 0)
        {
            _ubicacionesConStock = null;
            return;
        }

        _cargandoUbicaciones = true;
        _ubicacionesConStock = null;
        try { _ubicacionesConStock = await ProductoApi.ListarUbicacionesConStockAsync(_movProductoId); }
        catch (ApiException ex) { _dialogError = ex.Message; _ubicacionesConStock = []; }
        finally { _cargandoUbicaciones = false; }
    }

    private void AbrirEntrada() { LimpiarCampos(); _dialog = "entrada"; }
    private void AbrirSalida() { LimpiarCampos(); _dialog = "salida"; }
    private void AbrirAjuste() { LimpiarCampos(); _dialog = "ajuste"; }
    private void AbrirRecepcion(AvisoDevolucionDto a) { LimpiarCampos(); _recibiendoAviso = a; _movCantidad = a.Cantidad; _dialog = "devolucion"; }
    private void AbrirDevolucionDirecta(PrestamoDto p) { LimpiarCampos(); _devolviendoPrestamo = p; _movCantidad = p.Pendiente; _dialog = "devolucion"; }
    private void CerrarDialogo() { _dialog = null; _devolviendoPrestamo = null; _recibiendoAviso = null; }

    private async Task ConfirmarAjuste()
    {
        if (_guardando) return;
        if (_movProductoId <= 0) { _dialogError = "Seleccione un producto."; return; }
        if (_movUbicacionId <= 0) { _dialogError = "Seleccione una ubicación."; return; }
        if (_movCantidad <= 0) { _dialogError = "La cantidad debe ser mayor a cero."; return; }
        if (string.IsNullOrWhiteSpace(_movMotivo)) { _dialogError = "El motivo es obligatorio en un ajuste."; return; }

        _guardando = true; _dialogError = null;
        try
        {
            var r = await MovimientoApi.RegistrarAjusteAsync(new RegistrarAjusteDto(_movProductoId, _movUbicacionId, _movCantidad, _movAjustePositivo, _movMotivo!));
            _ok = $"Ajuste {r.NumeroMovimiento} confirmado.";
            _dialog = null;
            await CargarAsync();
        }
        catch (ApiException ex) { _dialogError = ex.Message; }
        finally { _guardando = false; }
    }

    private async Task ConfirmarDevolucion()
    {
        if (_guardando || (_devolviendoPrestamo is null && _recibiendoAviso is null)) return;
        if (_movUbicacionId <= 0) { _dialogError = "Seleccione dónde vuelve el material."; return; }
        if (_movCantidad <= 0) { _dialogError = "La cantidad debe ser mayor a cero."; return; }
        if (_movCantidad > MaximoDevolucion) { _dialogError = $"No podés registrar más de {MaximoDevolucion:N0} unidad(es): es lo {(_recibiendoAviso is null ? "que sigue prestado" : "que se avisó")}."; return; }

        _guardando = true; _dialogError = null;
        try
        {
            var origenId = _recibiendoAviso?.MovimientoOrigenId ?? _devolviendoPrestamo!.MovimientoId;
            var r = await MovimientoApi.RegistrarDevolucionAsync(new RegistrarDevolucionDto(origenId, _movUbicacionId, _movCantidad, "Devolución de préstamo", _recibiendoAviso?.Id));
            _ok = $"Devolución {r.NumeroMovimiento} confirmada.";
            _dialog = null;
            await CargarAsync();
        }
        catch (ApiException ex) { _dialogError = ex.Message; }
        finally { _guardando = false; }
    }



    // "Retorna: No" en cada fila es ruido — la gran mayoría de las Salidas no son
    // préstamo, así que solo se marca cuando SÍ retorna (ver captura del usuario,
    // 2026-09-18: pidió aligerar la tabla).
    private static string UbicacionORetorna(MovimientoDto m) =>
        m.TipoMovimiento == TipoMovimiento.Salida && m.Retorna
            ? $"{m.UbicacionCodigo} · Retorna"
            : m.UbicacionCodigo;
}
