@page "/productos"
@inject ProductoApiClient ProductoApi
@inject CategoriaApiClient CategoriaApi
@inject UnidadApiClient UnidadApi
@inject NavigationManager Nav
@inject AuthState AuthState

<PageTitle>Productos</PageTitle>

<div class="page-head">
    <div>
        <h1>Productos</h1>
        <p class="text-muted" style="margin-top:-6px">Filtre por categoría o busque por código y nombre.</p>
    </div>
    @if (AuthState.HasPermission(Permisos.ProductosCrear))
    {
        <button type="button" class="btn btn-primary" @onclick="AbrirNuevo">+ Nuevo producto</button>
    }
</div>

@if (_error is not null)
{
    <p class="dialog-error">@_error</p>
}

@if (_productos is null || _categorias is null)
{
    <p>Cargando…</p>
}
else
{
    <div class="filter-row">
        <input class="input" style="max-width:320px" placeholder="Buscar por código o nombre" value="@_query" @oninput="OnQuery" />
        <div class="chip-row">
            <button type="button" class="btn @(_filtroCategoriaId is null ? "btn-primary" : "btn-secondary")" @onclick="() => SetFiltro(null)">Todas</button>
            @foreach (var c in _categorias)
            {
                <button type="button" class="btn @(_filtroCategoriaId == c.Id ? "btn-primary" : "btn-secondary")" @onclick="() => SetFiltro(c.Id)">@c.CodigoCategoria</button>
            }
        </div>
    </div>

    @if (_productos!.Count == 0)
    {
        <p class="text-muted" style="margin-top:24px">No se encontraron productos.</p>
    }
    else
    {
        <div class="product-grid">
            @foreach (var p in _productos)
            {
                <div class="card elev-sm product-card">
                    <div class="product-card-img" style="@(string.IsNullOrWhiteSpace(p.ImagenUrl) ? "" : $"background-image:url('{ProductoApi.ApiBaseUrl}{p.ImagenUrl}')")">
                        @if (string.IsNullOrWhiteSpace(p.ImagenUrl))
                        {
                            <span>Foto del producto</span>
                        }
                    </div>
                    <div class="product-card-body">
                        <div class="product-card-top">
                            <span class="card-kicker" style="color:var(--color-neutral-700)">@p.CodigoProducto</span>
                            <span class="tag tag-neutral">@p.CategoriaNombre</span>
                            <VencimientoTag Proximo="p.ProximoVencimiento" />
                        </div>
                        <div class="card-title product-card-name" style="font-size:15px" title="@p.Nombre">@p.Nombre</div>
                        <div class="stock-line @(p.Existencia <= p.StockMinimo ? "warn" : "")">Stock: @p.Existencia.ToString("N0") / mín. @p.StockMinimo.ToString("N0") @p.UnidadMedida</div>
                        <div class="product-card-actions">
                            <button type="button" class="btn btn-icon-outline btn-icon-outline-accent" title="Ver" @onclick="() => VerProducto(p.Id)"><Icon Name="eye" Size="16" /></button>
                            @if (AuthState.HasPermission(Permisos.ProductosEditar))
                            {
                                <button type="button" class="btn btn-icon-outline btn-icon-outline-accent" title="Editar" @onclick="() => AbrirEditar(p)"><Icon Name="edit" Size="16" /></button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
        <Pager TotalItems="_total" PaginaActual="_pagina" PaginaActualChanged="CambiarPaginaAsync" TamanoPagina="TamanoPagina" />
    }
}

<Dialog OnClose="Cerrar" Visible="_dialogOpen" Title="@(_editandoId is null ? "Nuevo producto" : "Editar producto")">
    <Body>
        <div class="dialog-grid-2">
            @if (_editandoId is not null)
            {
                <div class="field">
                    <label for="pf-cod">Código</label>
                    <input class="input" id="pf-cod" value="@_form.Codigo" disabled />
                </div>
            }
            <div class="field">
                <label for="pf-cat">Categoría <span class="req">*</span></label>
                <select class="input" id="pf-cat" @bind="_form.CategoriaId" @bind:after="ActualizarPreviewCodigoAsync">
                    <option value="0">-- Seleccionar --</option>
                    @foreach (var c in _categorias ?? [])
                    {
                        <option value="@c.Id">@c.CodigoCategoria</option>
                    }
                </select>
            </div>
        </div>
        @if (_editandoId is null)
        {
            @if (_form.CategoriaId > 0)
            {
                <p class="text-muted" style="font-size:12px;margin:0">
                    Código: <strong>@(_codigoPreview ?? "…")</strong> (se genera automáticamente a partir de la categoría)
                </p>
            }
            else
            {
                <p class="text-muted" style="font-size:12px;margin:0">Seleccioná una categoría para ver el código que se va a generar.</p>
            }
        }
        <div class="field">
            <label for="pf-nom">Nombre <span class="req">*</span></label>
            <input class="input" id="pf-nom" @bind="_form.Nombre" />
        </div>
        <div class="dialog-grid-3">
            <div class="field">
                <label for="pf-uni">Unidad <span class="req">*</span></label>
                <select class="input" id="pf-uni" @bind="_form.UnidadMedida">
                    @foreach (var u in _unidades ?? [])
                    {
                        <option value="@u.CodigoUnidad">@u.CodigoUnidad — @u.Nombre</option>
                    }
                </select>
            </div>
            <div class="field">
                <label for="pf-cos">Costo unitario</label>
                <input class="input" id="pf-cos" type="number" min="0" step="0.01" @bind="_form.CostoUnitario" />
            </div>
            <div class="field">
                <label for="pf-sm">Stock mínimo</label>
                <input class="input" id="pf-sm" type="number" min="0" step="1" @bind="_form.StockMinimo" />
            </div>
        </div>
        <div class="field">
            <label>Imagen <span class="text-muted">(opcional)</span></label>
            <ZonaImagen Id="pf-img" PreviewUrl="@_form.ImagenPreviewUrl" Procesando="_procesandoImagen" OnChange="OnImagenSeleccionada" />
        </div>
        <div class="field">
            <label for="pf-det">Detalle</label>
            <textarea class="input" id="pf-det" rows="3" @bind="_form.Detalle"></textarea>
        </div>
        @if (_editandoId is null)
        {
            <p class="text-muted" style="font-size:12px;margin:0">La existencia inicial se carga después como un movimiento de Entrada, no acá.</p>
        }
        @if (_dialogError is not null)
        {
            <p class="dialog-error">@_dialogError</p>
        }
    </Body>
    <Actions>
        <button type="button" class="btn btn-ghost" @onclick="Cerrar">Cancelar</button>
        <button type="button" class="btn btn-primary" disabled="@_guardando" @onclick="Guardar">@(_guardando ? "Guardando…" : "Guardar")</button>
    </Actions>
</Dialog>

@code {
    private List<ProductoDto>? _productos;
    private List<CategoriaDto>? _categorias;
    private List<UnidadDto>? _unidades;
    private string _query = "";
    private int? _filtroCategoriaId;
    private string? _error;

    private const int TamanoPagina = 8;
    private int _pagina = 1;
    private int _total;

    private bool _dialogOpen;
    private bool _guardando;
    private bool _procesandoImagen;
    private int? _editandoId;
    private string? _dialogError;
    private string? _codigoPreview;
    private FormModelo _form = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _categorias = await CategoriaApi.ListarAsync();
            _unidades = await UnidadApi.ListarAsync();
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
            _categorias = [];
            _unidades = [];
        }

        await CargarPaginaAsync();
    }

    // Catálogo grande tras las cargas masivas (~600+ productos) — a diferencia del resto
    // de la app (Movimientos/Solicitudes/Auditoria, que traen la lista completa y paginan
    // en memoria), acá el filtro/búsqueda/paginado se resuelven en el backend
    // (ProductoApiClient.ListarPaginadoAsync) y solo se traen las ~8 filas de la página
    // actual — evita calcular existencia/próximo vencimiento de 600 filas para mostrar 8.
    private async Task CargarPaginaAsync()
    {
        try
        {
            var resultado = await ProductoApi.ListarPaginadoAsync(_filtroCategoriaId, incluirInactivos: false, _query, _pagina, TamanoPagina);
            _productos = resultado.Items.ToList();
            _total = resultado.Total;
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
            _productos = [];
            _total = 0;
        }
    }

    private async Task CargarAsync() => await CargarPaginaAsync();

    private void VerProducto(int id) => Nav.NavigateTo($"/productos/{id}");

    private CancellationTokenSource? _buscarCts;

    // Debounce: cada tecla ahora dispara un viaje al servidor (antes solo filtraba en
    // memoria), así que se espera una pausa de tipeo antes de pedir la página — si no,
    // escribir rápido manda un request por letra.
    private void OnQuery(ChangeEventArgs e)
    {
        _query = e.Value?.ToString() ?? "";

        _buscarCts?.Cancel();
        var cts = new CancellationTokenSource();
        _buscarCts = cts;
        _ = BuscarConPausaAsync(cts.Token);
    }

    private async Task BuscarConPausaAsync(CancellationToken ct)
    {
        try { await Task.Delay(300, ct); }
        catch (TaskCanceledException) { return; }
        if (ct.IsCancellationRequested) return;

        _pagina = 1;
        await CargarPaginaAsync();
        StateHasChanged();
    }

    private async Task SetFiltro(int? categoriaId)
    {
        _filtroCategoriaId = categoriaId;
        _pagina = 1;
        await CargarPaginaAsync();
    }

    private async Task CambiarPaginaAsync(int pagina)
    {
        _pagina = pagina;
        await CargarPaginaAsync();
    }

    private async Task AbrirNuevo()
    {
        _editandoId = null;
        _dialogError = null;
        _codigoPreview = null;
        _form = new FormModelo
        {
            CategoriaId = _categorias?.FirstOrDefault()?.Id ?? 0,
            // Primera unidad del catálogo, ya no "UNI" fijo: el catálogo es editable
            // y "UNI" podría estar desactivada.
            UnidadMedida = _unidades?.FirstOrDefault()?.CodigoUnidad ?? "",
        };
        _dialogOpen = true;
        await ActualizarPreviewCodigoAsync();
    }

    private void AbrirEditar(ProductoDto p)
    {
        _editandoId = p.Id;
        _dialogError = null;
        _codigoPreview = null;
        _form = new FormModelo
        {
            Codigo = p.CodigoProducto,
            Nombre = p.Nombre,
            CategoriaId = p.CategoriaId,
            UnidadMedida = p.UnidadMedida,
            CostoUnitario = p.CostoUnitario,
            StockMinimo = p.StockMinimo,
            Detalle = p.Detalle,
            // ImagenData queda en null a propósito: significa "no tocar la imagen actual"
            // si el usuario guarda sin elegir un archivo nuevo (ver ActualizarProductoDto).
            // La preview sí muestra la imagen ya guardada, apuntando al endpoint dedicado.
            ImagenPreviewUrl = string.IsNullOrWhiteSpace(p.ImagenUrl) ? null : $"{ProductoApi.ApiBaseUrl}{p.ImagenUrl}",
        };
        _dialogOpen = true;
    }

    private void Cerrar() => _dialogOpen = false;

    // Solo tiene sentido al crear: al editar el código ya está fijo y no se recalcula.
    private async Task ActualizarPreviewCodigoAsync()
    {
        if (_editandoId is not null || _form.CategoriaId <= 0)
        {
            _codigoPreview = null;
            return;
        }

        try
        {
            _codigoPreview = await ProductoApi.ObtenerSiguienteCodigoAsync(_form.CategoriaId);
        }
        catch (ApiException)
        {
            _codigoPreview = null;
        }
    }

    private const long TamanoMaximoImagenBytes = 5 * 1024 * 1024;

    // Ya no sube a un endpoint aparte — lee los bytes a memoria y arma un "data:" URL para
    // la vista previa. Los bytes viajan recién al tocar Guardar, como parte del mismo
    // Crear/Actualizar (ver Guardar() más abajo).
    private async Task OnImagenSeleccionada(InputFileChangeEventArgs e)
    {
        var archivo = e.File;
        if (archivo.Size > TamanoMaximoImagenBytes)
        {
            _dialogError = "La imagen no puede superar los 5 MB.";
            return;
        }

        _procesandoImagen = true;
        _dialogError = null;
        StateHasChanged();

        try
        {
            using var buffer = new MemoryStream();
            await using (var contenido = archivo.OpenReadStream(TamanoMaximoImagenBytes))
                await contenido.CopyToAsync(buffer);

            _form.ImagenData = buffer.ToArray();
            _form.ImagenContentType = archivo.ContentType;
            _form.ImagenPreviewUrl = $"data:{archivo.ContentType};base64,{Convert.ToBase64String(_form.ImagenData)}";
        }
        catch (Exception ex)
        {
            _dialogError = $"No se pudo procesar la imagen: {ex.Message}";
        }
        finally
        {
            _procesandoImagen = false;
        }
    }

    private async Task Guardar()
    {
        if (_guardando) return;

        if (string.IsNullOrWhiteSpace(_form.Nombre) || _form.CategoriaId <= 0)
        {
            _dialogError = "Nombre y categoría son obligatorios.";
            return;
        }

        _guardando = true;
        _dialogError = null;

        try
        {
            if (_editandoId is null)
            {
                await ProductoApi.CrearAsync(new CrearProductoDto(
                    _form.Nombre, _form.CategoriaId, _form.UnidadMedida,
                    _form.CostoUnitario, _form.StockMinimo, _form.Detalle, _form.ImagenData, _form.ImagenContentType));
            }
            else
            {
                await ProductoApi.ActualizarAsync(_editandoId.Value, new ActualizarProductoDto(
                    _form.Nombre, _form.CategoriaId, _form.UnidadMedida,
                    _form.CostoUnitario, _form.StockMinimo, _form.Detalle, _form.ImagenData, _form.ImagenContentType));
            }

            _dialogOpen = false;
            await CargarAsync();
        }
        catch (ApiException ex)
        {
            _dialogError = ex.Message;
        }
        finally
        {
            _guardando = false;
        }
    }

    private class FormModelo
    {
        public string Codigo { get; set; } = "";
        public string Nombre { get; set; } = "";
        public int CategoriaId { get; set; }
        public string UnidadMedida { get; set; } = "UNI";
        public decimal? CostoUnitario { get; set; }
        public int StockMinimo { get; set; }
        public string? Detalle { get; set; }
        public byte[]? ImagenData { get; set; }
        public string? ImagenContentType { get; set; }
        public string? ImagenPreviewUrl { get; set; }
    }
}