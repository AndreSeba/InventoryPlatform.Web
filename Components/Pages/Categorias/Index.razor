@page "/categorias"
@inject CategoriaApiClient CategoriaApi
@inject ProductoApiClient ProductoApi
@inject UsuarioApiClient UsuarioApi
@inject AuthState AuthState

<PageTitle>Categorías</PageTitle>

<div class="page-head">
    <div>
        <h1>Categorías</h1>
        <p class="text-muted" style="margin-top:-6px">Categorías utilizadas para clasificar el material promocional.</p>
    </div>
    @if (AuthState.HasPermission(Permisos.CategoriasCrear))
    {
        <button type="button" class="btn btn-primary" @onclick="AbrirNueva">+ Nueva categoría</button>
    }
</div>

@if (_error is not null)
{
    <p class="dialog-error">@_error</p>
}

@if (_categorias is null || _productos is null)
{
    <p>Cargando…</p>
}
else
{
    <div class="table-wrap" style="margin-top:24px">
        <table class="table">
            <thead><tr><th>Código</th><th>Descripción</th><th># Productos</th><th>Encargado</th><th></th></tr></thead>
            <tbody>
                @foreach (var c in Paginados())
                {
                    <tr>
                        <td>@c.CodigoCategoria</td>
                        <td class="text-muted">@c.Descripcion</td>
                        <td class="text-muted">@_productos.Count(p => p.CategoriaId == c.Id)</td>
                        <td class="text-muted">@(c.EncargadoNombre ?? "—")</td>
                        <td>
                            @if (AuthState.HasPermission(Permisos.CategoriasEditar))
                            {
                                <button type="button" class="btn btn-ghost btn-sm" @onclick="() => AbrirEditar(c)">Editar</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <Pager TotalItems="_categorias.Count" PaginaActual="_pagina" PaginaActualChanged="p => _pagina = p" TamanoPagina="TamanoPagina" />
}

<Dialog Visible="_dialogOpen" Title="@(_editandoId is null ? "Nueva categoría" : "Editar categoría")">
    <Body>
        <div class="field"><label for="cf-cod">Código</label><input class="input" id="cf-cod" @bind="_codigo" placeholder="CEREALES" /></div>
        <div class="field"><label for="cf-desc">Descripción</label><input class="input" id="cf-desc" @bind="_descripcion" placeholder="Cereales" /></div>
        <div class="field">
            <label for="cf-enc">Encargado</label>
            @if (_usuarios is null)
            {
                <p class="text-muted" style="font-size:12px;margin:0">No se pudo cargar la lista de usuarios — dejando el encargado como está.</p>
            }
            else
            {
                <select class="input" id="cf-enc" @bind="_encargadoId">
                    <option value="0">-- Sin encargado --</option>
                    @foreach (var u in _usuarios)
                    {
                        <option value="@u.Id">@u.NombreCompleto</option>
                    }
                </select>
                <p class="text-muted" style="font-size:12px;margin:4px 0 0">Recibe el aviso cuando se cree una solicitud con productos de esta categoría.</p>
            }
        </div>
        @if (_editandoId is not null)
        {
            <div class="field">
                <label style="display:flex;align-items:center;gap:8px;cursor:pointer">
                    <input type="checkbox" @bind="_activo" />
                    Activa (destildar para eliminarla — sigue existiendo para no romper el historial, pero deja de listarse y de poder usarse en productos nuevos)
                </label>
            </div>
        }
        @if (_dialogError is not null)
        {
            <p class="dialog-error">@_dialogError</p>
        }
    </Body>
    <Actions>
        <button type="button" class="btn btn-ghost" @onclick="Cerrar">Cancelar</button>
        <button type="button" class="btn btn-primary" disabled="@_guardando" @onclick="Guardar">@(_guardando ? "Guardando…" : "Guardar")</button>
    </Actions>
</Dialog>

@code {
    private List<CategoriaDto>? _categorias;
    private List<ProductoDto>? _productos;
    private List<UsuarioDto>? _usuarios;
    private string? _error;

    private const int TamanoPagina = 10;
    private int _pagina = 1;

    private List<CategoriaDto> Paginados() => (_categorias ?? [])
        .Skip((_pagina - 1) * TamanoPagina)
        .Take(TamanoPagina)
        .ToList();

    private bool _dialogOpen;
    private bool _guardando;
    private string? _dialogError;
    private int? _editandoId;
    private string _codigo = "";
    private string? _descripcion;
    private bool _activo;
    private int _encargadoId;

    protected override async Task OnInitializedAsync() => await CargarAsync();

    private async Task CargarAsync()
    {
        try
        {
            _categorias = await CategoriaApi.ListarAsync();
            _productos = await ProductoApi.ListarAsync();
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
            _categorias = [];
            _productos = [];
        }

        // usuarios.gestionar puede faltar en roles custom que solo tienen categorias.editar —
        // sin esa lista igual se puede editar la categoría, solo no se puede elegir un
        // encargado nuevo (ver mensaje en el diálogo).
        try
        {
            _usuarios = await UsuarioApi.ListarAsync();
        }
        catch (ApiException)
        {
            _usuarios = null;
        }
    }

    private void AbrirNueva()
    {
        _editandoId = null;
        _codigo = "";
        _descripcion = null;
        _encargadoId = 0;
        _dialogError = null;
        _dialogOpen = true;
    }

    private void AbrirEditar(CategoriaDto c)
    {
        _editandoId = c.Id;
        _codigo = c.CodigoCategoria;
        _descripcion = c.Descripcion;
        _activo = c.Activo;
        _encargadoId = c.EncargadoId ?? 0;
        _dialogError = null;
        _dialogOpen = true;
    }

    private void Cerrar()
    {
        _dialogOpen = false;
        _codigo = "";
        _descripcion = null;
        _dialogError = null;
    }

    private async Task Guardar()
    {
        if (_guardando) return;
        if (string.IsNullOrWhiteSpace(_codigo)) { _dialogError = "Ingrese un código."; return; }

        _guardando = true;
        _dialogError = null;

        var encargadoId = _encargadoId > 0 ? _encargadoId : (int?)null;

        try
        {
            if (_editandoId is null)
                await CategoriaApi.CrearAsync(new CrearCategoriaDto(_codigo, _descripcion, encargadoId));
            else
                await CategoriaApi.ActualizarAsync(_editandoId.Value, new ActualizarCategoriaDto(_codigo, _descripcion, _activo, encargadoId));

            Cerrar();
            await CargarAsync();
        }
        catch (ApiException ex)
        {
            _dialogError = ex.Message;
        }
        finally
        {
            _guardando = false;
        }
    }
}
