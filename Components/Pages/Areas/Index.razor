@page "/areas"
@inject AreaApiClient AreaApi
@inject SolicitudApiClient SolicitudApi
@inject AuthState AuthState

<PageTitle>Áreas</PageTitle>

<div class="page-head">
    <div>
        <h1>Áreas</h1>
        <p class="text-muted" style="margin-top:-6px">Áreas que pueden solicitar material promocional.</p>
    </div>
    @if (AuthState.HasPermission(Permisos.AreasCrear))
    {
        <button type="button" class="btn btn-primary" @onclick="AbrirNueva">+ Nueva área</button>
    }
</div>

@if (_error is not null)
{
    <p class="dialog-error">@_error</p>
}

@if (_areas is null || _solicitudes is null)
{
    <p>Cargando…</p>
}
else
{
    <div class="table-wrap" style="margin-top:24px">
        <table class="table">
            <thead><tr><th>Código</th><th>Nombre</th><th># Solicitudes</th><th></th></tr></thead>
            <tbody>
                @foreach (var a in Paginados())
                {
                    <tr>
                        <td>@a.CodigoArea</td>
                        <td class="text-muted">@a.NombreArea</td>
                        <td class="text-muted">@_solicitudes.Count(s => s.AreaId == a.Id)</td>
                        <td>
                            @if (AuthState.HasPermission(Permisos.AreasEditar))
                            {
                                <button type="button" class="btn btn-ghost btn-sm" @onclick="() => AbrirEditar(a)">Editar</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <Pager TotalItems="_areas.Count" PaginaActual="_pagina" PaginaActualChanged="p => _pagina = p" TamanoPagina="TamanoPagina" />
}

<Dialog Visible="_dialogOpen" Title="@(_editandoId is null ? "Nueva área" : "Editar área")">
    <Body>
        <div class="field"><label for="af-cod">Código</label><input class="input" id="af-cod" @bind="_codigo" placeholder="MARKETING" /></div>
        <div class="field"><label for="af-nom">Nombre</label><input class="input" id="af-nom" @bind="_nombre" placeholder="Marketing" /></div>
        @if (_editandoId is not null)
        {
            <div class="field">
                <label style="display:flex;align-items:center;gap:8px;cursor:pointer">
                    <input type="checkbox" @bind="_activo" />
                    Activa (destildar para eliminarla — sigue existiendo para no romper el historial, pero deja de listarse y de poder usarse en solicitudes nuevas)
                </label>
            </div>
        }
        @if (_dialogError is not null)
        {
            <p class="dialog-error">@_dialogError</p>
        }
    </Body>
    <Actions>
        <button type="button" class="btn btn-ghost" @onclick="Cerrar">Cancelar</button>
        <button type="button" class="btn btn-primary" disabled="@_guardando" @onclick="Guardar">@(_guardando ? "Guardando…" : "Guardar")</button>
    </Actions>
</Dialog>

@code {
    private List<AreaDto>? _areas;
    private List<SolicitudDto>? _solicitudes;
    private string? _error;

    private const int TamanoPagina = 10;
    private int _pagina = 1;

    private List<AreaDto> Paginados() => (_areas ?? [])
        .Skip((_pagina - 1) * TamanoPagina)
        .Take(TamanoPagina)
        .ToList();

    private bool _dialogOpen;
    private bool _guardando;
    private string? _dialogError;
    private int? _editandoId;
    private string _codigo = "";
    private string _nombre = "";
    private bool _activo;

    protected override async Task OnInitializedAsync() => await CargarAsync();

    private async Task CargarAsync()
    {
        try
        {
            _areas = await AreaApi.ListarAsync();
            _solicitudes = await SolicitudApi.ListarAsync();
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
            _areas = [];
            _solicitudes = [];
        }
    }

    private void AbrirNueva()
    {
        _editandoId = null;
        _codigo = ""; _nombre = "";
        _dialogError = null;
        _dialogOpen = true;
    }

    private void AbrirEditar(AreaDto a)
    {
        _editandoId = a.Id;
        _codigo = a.CodigoArea;
        _nombre = a.NombreArea;
        _activo = a.Activo;
        _dialogError = null;
        _dialogOpen = true;
    }

    private void Cerrar()
    {
        _dialogOpen = false;
        _codigo = ""; _nombre = "";
        _dialogError = null;
    }

    private async Task Guardar()
    {
        if (_guardando) return;
        if (string.IsNullOrWhiteSpace(_codigo) || string.IsNullOrWhiteSpace(_nombre)) { _dialogError = "Código y nombre son obligatorios."; return; }

        _guardando = true;
        _dialogError = null;

        try
        {
            if (_editandoId is null)
                await AreaApi.CrearAsync(new CrearAreaDto(_codigo, _nombre));
            else
                await AreaApi.ActualizarAsync(_editandoId.Value, new ActualizarAreaDto(_codigo, _nombre, _activo));

            Cerrar();
            await CargarAsync();
        }
        catch (ApiException ex)
        {
            _dialogError = ex.Message;
        }
        finally
        {
            _guardando = false;
        }
    }
}
