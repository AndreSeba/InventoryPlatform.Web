@page "/auditoria"
@inject AuditoriaApiClient AuditoriaApi
@inject ProductoApiClient ProductoApi
@inject UbicacionApiClient UbicacionApi
@inject AlmacenApiClient AlmacenApi
@inject AreaApiClient AreaApi
@inject CategoriaApiClient CategoriaApi
@inject RolApiClient RolApi
@inject UsuarioApiClient UsuarioApi

<PageTitle>Auditoría</PageTitle>

<div class="page-head">
    <div>
        <h1>Auditoría</h1>
        <p class="text-muted" style="margin-top:-6px">Quién cambió qué, cuándo y con qué valores — en todos los módulos.</p>
    </div>
</div>

@if (_error is not null)
{
    <p class="dialog-error">@_error</p>
}

@if (_catalogo is null || _registros is null)
{
    <p>Cargando…</p>
}
else
{
    <div class="filter-row" style="flex-wrap:wrap">
        <select class="input" style="max-width:200px" @bind="_filtroEntidad" @bind:after="AplicarFiltrosAsync">
            <option value="">Todas las entidades</option>
            @foreach (var e in _catalogo.Entidades)
            {
                <option value="@e">@AuditoriaLegible.Entidad(e)</option>
            }
        </select>
        <select class="input" style="max-width:200px" @bind="_filtroAccion" @bind:after="AplicarFiltrosAsync">
            <option value="">Todas las acciones</option>
            @foreach (var a in _catalogo.Acciones)
            {
                <option value="@a">@AuditoriaLegible.Accion(a)</option>
            }
        </select>
        <input class="input" style="max-width:170px" type="date" title="Desde" @bind="_filtroDesde" @bind:after="AplicarFiltrosAsync" />
        <input class="input" style="max-width:170px" type="date" title="Hasta" @bind="_filtroHasta" @bind:after="AplicarFiltrosAsync" />
        @if (_filtroEntidad != "" || _filtroAccion != "" || _filtroDesde is not null || _filtroHasta is not null)
        {
            <button type="button" class="btn btn-ghost" @onclick="LimpiarFiltrosAsync">Limpiar filtros</button>
        }
    </div>

    @if (_registros.Count == 0)
    {
        <p class="text-muted" style="margin-top:20px">Sin movimientos de auditoría para este filtro.</p>
    }
    else
    {
        <div class="table-wrap">
            <table class="table">
                <thead>
                    <tr><th>Fecha</th><th>Entidad</th><th>Id</th><th>Acción</th><th>Usuario</th><th>Motivo</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var r in Paginados())
                    {
                        <tr>
                            <td class="text-muted">@r.FechaHora.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@AuditoriaLegible.Entidad(r.Entidad)</td>
                            <td class="text-muted">@r.EntidadId</td>
                            <td><span class="@AccionTagClase(r.Accion)">@AuditoriaLegible.Accion(r.Accion)</span></td>
                            <td class="text-muted">@r.UsuarioNombre</td>
                            <td class="text-muted celda-truncada" title="@r.Motivo">@r.Motivo</td>
                            <td><button type="button" class="btn btn-ghost btn-sm" @onclick="() => Alternar(r.Id)">@(_expandidos.Contains(r.Id) ? "Ocultar" : "Ver cambios")</button></td>
                        </tr>
                        @if (_expandidos.Contains(r.Id))
                        {
                            <tr>
                                <td colspan="7" style="background:var(--color-neutral-100)">
                                    @{ var diferencias = AuditoriaLegible.Diferencias(r.Entidad, r.ValorAnterior, r.ValorNuevo, _nombres); }
                                    @if (diferencias.Count == 0)
                                    {
                                        <p class="text-muted" style="margin:8px 4px">Sin campos con cambios registrados.</p>
                                    }
                                    else
                                    {
                                        <table class="table" style="margin:8px 0">
                                            <thead><tr><th>Campo</th><th>Antes</th><th>Después</th></tr></thead>
                                            <tbody>
                                                @foreach (var d in diferencias)
                                                {
                                                    <tr>
                                                        <td style="vertical-align:top;white-space:nowrap">@d.Campo</td>
                                                        <td class="text-muted" style="vertical-align:top">@foreach (var l in d.Antes) { <div>@l</div> }</td>
                                                        <td style="vertical-align:top">@foreach (var l in d.Despues) { <div>@l</div> }</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <Pager TotalItems="_registros.Count" PaginaActual="_pagina" PaginaActualChanged="p => _pagina = p" TamanoPagina="TamanoPagina" />
    }
}

@code {
    private CatalogoAuditoriaDto? _catalogo;
    private List<AuditoriaDto>? _registros;
    private string? _error;
    private readonly CatalogosAuditoria _nombres = new();

    private string _filtroEntidad = "";
    private string _filtroAccion = "";
    private DateTime? _filtroDesde;
    private DateTime? _filtroHasta;

    private readonly HashSet<int> _expandidos = [];

    private const int TamanoPagina = 15;
    private int _pagina = 1;

    private List<AuditoriaDto> Paginados() => (_registros ?? [])
        .Skip((_pagina - 1) * TamanoPagina)
        .Take(TamanoPagina)
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _catalogo = await AuditoriaApi.ObtenerCatalogoAsync();
            _registros = await AuditoriaApi.ListarAsync();
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
            _catalogo = new CatalogoAuditoriaDto([], []);
            _registros = [];
        }
        await CargarNombresAsync();
    }

    // Para decir «Vaso logo Mabel» en vez de «ProductoId 1392». Cada catálogo es opcional: si el usuario no tiene el
    // permiso para listarlo (o falla), esos ids se muestran como «#id» y la auditoría sigue funcionando.
    private async Task CargarNombresAsync()
    {
        static async Task Cargar<T>(Func<Task<List<T>>> pedir, Dictionary<int, string> destino, Func<T, (int Id, string Nombre)> mapa)
        {
            try { foreach (var x in await pedir()) { var (id, nombre) = mapa(x); destino[id] = nombre; } }
            catch (Exception) { /* sin permiso o sin respuesta: se queda con «#id» */ }
        }

        await Cargar(() => ProductoApi.ListarAsync(null, true), _nombres.Productos, p => (p.Id, p.Nombre));
        await Cargar(() => UbicacionApi.ListarAsync(true), _nombres.Ubicaciones, u => (u.Id, u.CodigoUbicacion));
        await Cargar(() => AlmacenApi.ListarAsync(true), _nombres.Almacenes, a => (a.Id, a.Nombre));
        await Cargar(() => AreaApi.ListarAsync(true), _nombres.Areas, a => (a.Id, a.NombreArea));
        await Cargar(() => CategoriaApi.ListarAsync(true), _nombres.Categorias, c => (c.Id, c.CodigoCategoria));
        await Cargar(() => RolApi.ListarAsync(), _nombres.Roles, r => (r.Id, r.Nombre));
        await Cargar(() => UsuarioApi.ListarAsync(), _nombres.Usuarios, u => (u.Id, u.NombreCompleto));
    }

    private async Task AplicarFiltrosAsync()
    {
        _pagina = 1;
        _error = null;
        try
        {
            _registros = await AuditoriaApi.ListarAsync(
                string.IsNullOrEmpty(_filtroEntidad) ? null : _filtroEntidad,
                string.IsNullOrEmpty(_filtroAccion) ? null : _filtroAccion,
                null, _filtroDesde, _filtroHasta?.AddDays(1).AddTicks(-1));
        }
        catch (ApiException ex) { _error = ex.Message; }
    }

    private async Task LimpiarFiltrosAsync()
    {
        _filtroEntidad = ""; _filtroAccion = ""; _filtroDesde = null; _filtroHasta = null;
        await AplicarFiltrosAsync();
    }

    private void Alternar(int id)
    {
        if (!_expandidos.Add(id))
            _expandidos.Remove(id);
    }

    private static string AccionTagClase(string accion) => accion switch
    {
        var a when a.StartsWith("Crear") || a.StartsWith("Registrar") => "tag tag-accent",
        var a when a.StartsWith("Desactivar") || a.StartsWith("Rechazar") => "tag tag-warn",
        _ => "tag tag-outline",
    };
}
